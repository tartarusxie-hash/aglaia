---
import StylePage from "../../views/StylePage.astro";

// 瑞士风格条目 v0.1（2026-11-13）。正文见 workspace/goals/figma/entries/swiss-style-2026-11-13.md。
const style = {
  id: "swiss-style",
  nameZh: "瑞士风格",
  nameEn: "Swiss Style",
  years: "约 1950–1970 年代",
  origin: "瑞士苏黎世与巴塞尔",
  definition: "瑞士风格是一套以数学网格、无衬线字体与客观摄影实现清晰传达的设计方法（约 1950–1970 年代，瑞士苏黎世与巴塞尔），它的信条是：清晰即诚实。",
  definitionEn: "The Swiss Style is a design method built on mathematical grids, sans-serif typography and objective photography (c. 1950s–1970s, Zurich and Basel, Switzerland), founded on one belief: clarity is honesty.",
  intro: [
    "瑞士风格诞生于二战后的苏黎世与巴塞尔。它的信条只有一句话：清晰即诚实。设计师用数学网格、无衬线字体、客观摄影与非对称排版，把信息传达得清清楚楚；拒绝装饰不是品味，而是一种伦理立场——装饰会干扰信息，就是不诚实。",
    "1958 年，米勒-布罗克曼等人创办《新平面设计》杂志，把这套方法传播到全世界，它从此被称为\"国际主义风格\"。1957 年问世的 Helvetica 成了它的声音；1981 年的《网格系统》把它写成了手册。",
    "今天，这套方法已经是 UI 设计的默认语法：12 列网格、8pt 间距、无衬线字体的层级，几乎每个 App 都在用它——大多数人用着它，却不知道它叫瑞士风格。",
  ],
  promptZh: "用瑞士风格设计一个 App 首页：严格的 12 列网格、黑白为主、一点红色强调、左对齐无衬线字体，层级靠字号与字重，清晰、客观、没有装饰。",
  promptEn: "Design an app home screen in Swiss Style: a strict 12-column grid, black and white with one red accent, left-aligned sans-serif type, hierarchy by size and weight — clear, objective, no decoration.",
  variants: [
    {
      label: "海报",
      zh: "用瑞士风格做一张音乐会海报：网格对齐的无衬线大字标题、黑白照片、一点红色强调，左对齐、右参差，信息清晰第一。",
      en: "Design a concert poster in Swiss Style: grid-aligned large sans-serif headline, black-and-white photography, one red accent, flush left ragged right — information first.",
    },
    {
      label: "品牌",
      zh: "用瑞士风格设计一个银行的品牌视觉：黑白两色、严格网格、Helvetica 式无衬线字体，冷静、可信、精确。",
      en: "Design a bank brand identity in Swiss Style: black and white only, strict grid, Helvetica-style sans-serif type — calm, trustworthy, precise.",
    },
    {
      label: "网页",
      zh: "用瑞士风格设计一个新闻网站首页：12 列网格、模块化卡片、黑白照片配红色分类标签，层级分明、没有装饰。",
      en: "Design a news homepage in Swiss Style: a 12-column grid, modular cards, black-and-white photos with red category tags — clear hierarchy, no decoration.",
    },
  ],
  palette: [
    { hex: "#141414", name: "墨黑", role: "主色·文字与结构" },
    { hex: "#FFFFFF", name: "纸白", role: "底色·纸张白" },
    { hex: "#D43C28", name: "瑞士红", role: "强调·取自《Musica Viva》" },
    { hex: "#8A8A8A", name: "中灰", role: "次要文字" },
    { hex: "#F4F4F4", name: "浅灰", role: "分隔与底色" },
  ],
  typography: "无衬线是唯一选择。源头是 Helvetica（1957）与 Univers（1957），均为商业字体，需购买授权；Akzidenz-Grotesk 是它们的先辈。开源替代：Inter（站内已有）、Archivo、Liberation Sans。层级只靠字号与字重；左对齐、右参差；不用斜体作装饰。",
  composition: ["模块化网格（常 6 或 12 列）", "非对称排版", "数学比例", "留白即结构", "所有元素对齐网格线"],
  forms: "网格、色块、客观摄影图片；直线与直角；拒绝装饰。",
  texture: "纸张白底；干净印刷；黑白照片；红色强调块。",
  donts: ["不用装饰字体", "不居中排版（左对齐是铁律）", "不用渐变、阴影、圆角装饰", "不堆砌色彩（黑白 + 一个强调色）", "不打破网格随意摆放"],
  gallery: [
    {
      title: "米勒-布罗克曼《Musica Viva》海报",
      artist: "约瑟夫·米勒-布罗克曼",
      year: "1958",
      status: "版权期",
      note: "看：几何模块按音乐的比例关系排布，网格里藏着节奏；亚麻油毡凸版 + 活字印刷，128 × 90.5 cm。藏：纽约现代艺术博物馆。",
      link: "https://www.moma.org/collection/works/7233",
      linkLabel: "查看原作（MoMA 藏品页）↗",
    },
