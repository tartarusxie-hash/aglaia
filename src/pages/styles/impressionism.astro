      en: "Design a skincare brand visual in Impressionist style: soft light on a water-lily pond, pale blue-violet gradients, fine broken-brushstroke texture — gentle, natural, unforced.",
    },
    {
      label: "网页",
      zh: "用印象派风格设计一个旅行网站首页：截取式构图（画面像随手截下的一景）、明亮的蓝天与水面、非对称留白，呼吸感强。",
      en: "Design a travel homepage in Impressionist style: a cropped, snapshot-like composition, bright blue sky and water, asymmetric white space — airy and open.",
    },
  ],
  palette: [
    { hex: "#6FA8C9", name: "睡莲蓝", role: "主色·天空与水面" },
    { hex: "#9B8AC4", name: "紫藤紫", role: "辅色·阴影与花影" },
    { hex: "#F2A7B8", name: "粉霞", role: "点缀·花朵与晚霞" },
    { hex: "#F2D16B", name: "柠檬黄", role: "点缀·阳光与光斑" },
    { hex: "#5E8C6A", name: "水面绿", role: "辅色·植物" },
    { hex: "#F7F3EA", name: "米白", role: "底色" },
