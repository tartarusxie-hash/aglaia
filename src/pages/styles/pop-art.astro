      en: "Design a product-launch social card in Pop Art style: the product image repeated three times like a silkscreen print, clashing pink and blue, a short tagline in a speech balloon — light and fun.",
    },
  ],
  palette: [
    { hex: "#E4002B", name: "波普红", role: "主色·视觉锚点" },
    { hex: "#FFD400", name: "波普黄", role: "主色·爆炸与高光" },
    { hex: "#0057B8", name: "波普蓝", role: "主色·结构" },
    { hex: "#FF6FAE", name: "波普粉", role: "辅色·名人与时尚" },
