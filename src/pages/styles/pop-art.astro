    { name: "罗伊·利希滕斯坦", note: "把漫画格放大成巨画，Ben-Day 网点与拟声词的代言人。" },
    { name: "理查德·汉密尔顿", note: "英国波普的起点，拼贴与挪用的先驱。" },
    { name: "克莱斯·奥登伯格", note: "软雕塑，把日常物放大、变软、变荒诞。" },
    { name: "詹姆斯·罗森奎斯特", note: "广告画出身，把广告牌的尺度与拼贴带进绘画。" },
