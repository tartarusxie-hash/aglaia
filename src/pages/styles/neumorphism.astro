    {
      label: "品牌",
      zh: "用新拟态风格设计一个冥想 App 的首页：淡粉灰底面、压入式圆形按钮、几乎没有文字装饰，呼吸感、安静、克制。",
      en: "Design a meditation app home screen in neumorphic style: a pale pink-grey surface, pressed-in round buttons, almost no text decoration — breathing room, quiet, restrained.",
    },
    {
      label: "网页",
      zh: "用新拟态风格做一个网页计算器小部件：同色圆角按键、按下时由凸变凹，柔软、好玩、只作装饰。",
      en: "Build a web calculator widget in neumorphic style: same-color rounded keys that sink from raised to pressed when tapped — soft, playful, decorative only.",
    },
  ],
  palette: [
    { hex: "#E0E5EC", name: "浅灰底", role: "底色·经典新拟态底" },
    { hex: "#FFFFFF", name: "亮影白", role: "左上高光" },
    { hex: "#A3B1C6", name: "暗影灰蓝", role: "右下阴影" },
    { hex: "#6D7B8D", name: "文字深灰", role: "正文" },
    { hex: "#8FA3BF", name: "点缀蓝灰", role: "选中态" },
    { hex: "#E9E4DA", name: "米白变体", role: "暖色底" },
  ],
  typography: "细无衬线。开源替代：Inter Light（OFL）、Roboto Light（Apache 2.0）、Poppins Light（OFL）；字重 300–400，标题不加粗、靠字号分层。注意：细字 + 低对比是双重可读性风险，正文慎用。",
  composition: ["同色卡片阵列", "圆角半径大（16–24px）", "间距均匀、留白充足", "光源固定左上", "凸起与凹陷成对出现（按钮凸、输入框凹）"],
