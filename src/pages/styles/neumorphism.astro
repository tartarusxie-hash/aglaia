  timeline: [
    { year: "2019 年 8 月", text: "华为 HarmonyOS 智慧屏（Honor Vision）发布，被后世列为新拟态早期实例。" },
    { year: "2019 年 11 月", text: "普柳托在 Dribbble 发布\"Skeuomorph Mobile Banking\"概念稿，迅速走红。" },
    { year: "2019 年 12 月", text: "马莱维奇发表《Neumorphism in user interfaces》，术语定名并走红；同文即警告可访问性问题。" },
    { year: "2020 年", text: "Dribbble 与 Behance 上新拟态概念稿成潮；11 月 macOS Big Sur 发布，带入部分新拟态元素。" },
    { year: "2021 年", text: "热度消退，玻璃拟态接棒成为主流。" },
    { year: "2021 年 12 月", text: "马莱维奇提出黏土拟态，被定位为新拟态的\"友好继任者\"。" },
  ],
  figures: [
    { name: "亚历山大·普柳托", note: "银行 App 概念稿作者，新拟态视觉的起点。" },
    { name: "米哈乌·马莱维奇", note: "定名并推广了新拟态（也是玻璃拟态与黏土拟态的命名者）。" },
    { name: "杰森·凯利", note: "在评论中率先提出 \"neuomorphism\" 一词（命名归属有分歧）。" },
