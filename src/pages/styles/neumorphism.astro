    { name: "玻璃拟态", note: "新拟态的后代", href: "/styles/glassmorphism/" },
    { name: "黏土拟态", note: "新拟态的友好继任者", href: "/styles/claymorphism/" },
    { name: "极简主义", note: "单色克制", href: "/styles/minimalism/" },
