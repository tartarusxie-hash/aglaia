---
import StylePage from "../../views/StylePage.astro";

// 欧普艺术条目 v0.1（2026-11-13）。正文见 workspace/goals/figma/entries/op-art-2026-11-13.md。
const style = {
  id: "op-art",
  nameZh: "欧普艺术",
  nameEn: "Op Art",
  years: "约 1955/1960 年代—1970 年代",
  origin: "巴黎、伦敦、布宜诺斯艾利斯，1965 年于纽约汇合",
  definition: "欧普艺术是以精确几何图案与色彩并置制造视觉幻觉的艺术，静止画面中呈现运动、振动与深度。",
  definitionEn: "Op Art uses precise geometric patterns and juxtaposed colors to create optical illusions — movement, vibration and depth on a perfectly still surface.",
  intro: [
    "欧普艺术（Op Art，\"Optical Art\"的缩写）约 1955 年至 1970 年代，源头在巴黎、伦敦与布宜诺斯艾利斯，1965 年在纽约汇合为一场全球现象。它的材料不是颜料或形象，而是\"知觉本身\"：用精确的几何图案与色彩并置欺骗视觉，在静止的平面上制造运动、振动与深度的幻觉。名称由《时代》杂志在 1964 年创造；1965 年 MoMA 的《应答之眼》展览是运动的高峰，布里奇特·赖利的《流》登上了展览图录封面。",
    "欧普艺术有两条路：一条是黑白的几何幻觉——赖利的波浪线与压缩方格、瓦萨雷利的扭曲网格，靠线条的间距与弯曲让平面起伏；另一条是色彩的振动——理查德·安努斯凯维奇的红底同心方，让互补色在等强度的并置中\"嗡嗡作响\"。两条路共享同一种纪律：硬边平涂、无笔触、无渐变，一切效果都来自计算，而不是手感。",
    "对今天的设计者来说，欧普艺术是视觉动效与背景图案的宝库，但要用得克制：高频振动图案容易引发眩晕与不适，在界面里只能作小面积装饰，绝不能铺满正文区。",
  ],
  promptZh: "用欧普艺术风格设计一个音乐 App 的启动页：黑白波浪线规律排布、中间渐进收紧产生振动感、硬边平涂无渐变，精确、冷静、让人眼前一动。",
  promptEn: "Design a music app launch screen in Op Art style: black-and-white wavy lines in a regular rhythm, progressively tightening toward the center to create vibration, hard-edged flat color with no gradients — precise, cool, and visually electric.",
  variants: [
    {
      label: "海报",
      zh: "用欧普艺术风格做一张展览海报：同心圆从中心向外扩散、黑白交替、边缘一组红蓝互补色条振动，视觉冲击强、但文字区保持干净。",
      en: "Design an exhibition poster in Op Art style: concentric circles radiating from the center in alternating black and white, with a strip of vibrating red-blue complementary colors at the edge — high visual impact, but keep the text area clean.",
    },
    {
      label: "品牌",
      zh: "用欧普艺术风格设计一个眼镜品牌的视觉识别：扭曲网格作底纹、黑白为主、只用一个品牌色作振动点，精确、聪明、有科学感。",
      en: "Design an eyewear brand identity in Op Art style: a warped grid as the background texture, black and white dominant, one brand color as the vibrating accent — precise, clever, scientific.",
    },
    {
      label: "网页",
      zh: "用欧普艺术风格设计一个设计工作室网站首页：棋盘格在鼠标经过时轻微扭曲、黑白高对比、几何无衬线标题，动效克制、绝不让图案干扰阅读。",
      en: "Design a design studio homepage in Op Art style: a checkerboard that warps slightly on hover, high-contrast black and white, geometric sans-serif headlines — restrained motion, never let the pattern disturb reading.",
    },
  ],
  palette: [
    { hex: "#000000", name: "纯黑", role: "主色·图案线条" },
    { hex: "#FFFFFF", name: "纯白", role: "底色·高对比的另一极" },
    { hex: "#E63329", name: "红", role: "互补振动·暖极" },
    { hex: "#00A6A6", name: "青", role: "互补振动·冷极" },
    { hex: "#F5C400", name: "黄", role: "强调·小面积点缀" },
    { hex: "#8C8C8C", name: "灰", role: "过渡·降低对比时用" },
  ],
  typography: "几何无衬线是正选，或随图案弯曲的字体作装饰。开源推荐：标题用 Poppins（OFL 开源）或 Montserrat（OFL 开源），粗字重、大字号；正文用 Inter（OFL 开源）。弯曲变形的字体只用于标题装饰，不用于正文。",
  composition: ["规律图案加渐进扰动：先立一个严格的规律（等距线条、等大方格），再让它在某一处渐进收紧、弯曲或放大", "中心压缩/膨胀：图案向中心收紧产生凹陷感，向外膨胀产生凸起感", "图案满幅：幻觉图案铺满整个区域，不留\"安全区\"", "文字区隔离：正文与按钮放在干净的纯色块上，与振动图案严格分开", "留白极少：画面由图案填满，留白只出现在文字区"],
  forms: "波浪线、扭曲网格、同心圆、棋盘格、放射线；同心方与嵌套几何。",
  texture: "硬边平涂、无笔触、无渐变；母题：莫尔纹（叠加产生的干涉纹）、振动条纹、膨胀的球面网格、棋盘格错位。",
  donts: ["不用柔和渐变与手绘笔触（欧普的效果来自计算，不是手感）", "不在正文区、按钮与表单背景上用高频振动图案（易引发眩晕与可访问性问题）", "不把幻觉图案用作大面积滚动背景（滚动时振动会加剧不适）", "不混用写实照片（会破坏\"纯知觉\"的幻觉）"],
  gallery: [
    {
      title: "瓦萨雷利《斑马》",
      artist: "维克托·瓦萨雷利",
      year: "1937",
      status: "版权期",
      note: "看：被公认的最早的欧普作品之一——两匹斑马没有轮廓线，纯靠黑白条纹的弯曲与粗细变化\"长\"出来；眼睛先看到条纹，脑子后拼出斑马。（藏地说法不一：蓬皮杜中心与私人收藏两种说法，本篇未写藏地。）",
      link: "https://www.singulart.com/blog/en/2024/02/25/zebra-by-victor-vasarelys/",
      linkLabel: "查看赏析（Singulart）↗",
    },
    {
      title: "赖利《运动中的方形》",
      artist: "布里奇特·赖利",
      year: "1961",
      status: "版权期",
      note: "看：赖利的突破之作——一排黑白方格从左到右渐进压缩，画面像在中间对折、向内塌陷；只用方格与黑白，就让平面动了起来。藏：英国艺术委员会收藏。",
      link: "https://bridget-riley.publications.britishart.yale.edu/catalogue/1/",
      linkLabel: "查看图录（耶鲁英国艺术中心）↗",
    },
    {
      title: "赖利《流》（Current）",
      artist: "布里奇特·赖利",
      year: "1964",
      status: "版权期",
      note: "看：1965 年 MoMA《应答之眼》展览图录封面——手绘的波浪黑线等距排布，整面画布像水流一样振动；策展人说\"眼睛仿佛被纯粹的能量轰击\"。藏：纽约现代艺术博物馆 MoMA。",
      link: "https://www.moma.org/collection/works/79998",
      linkLabel: "查看原作（MoMA 藏品页）↗",
    },
    {
      title: "瓦萨雷利《织女星》系列",
      artist: "维克托·瓦萨雷利",
      year: "1960 年代",
      status: "版权期",
      note: "看：平面的棋盘格被系统性地扭曲——中心方格胀大、线条弯曲，像一个球体正从画布里顶出来；系列得名于天琴座的织女星。代表作《Vega-Nor》1969、《Vega-bleu》1968。",
      link: "https://galeriefleury.com/en/exposition/another-dimension/",
      linkLabel: "查看介绍（Galerie A&R Fleury）↗",
    },
    {
      title: "安努斯凯维奇《Mercurius in the Vessel》",
      artist: "理查德·安努斯凯维奇",
      year: "1963",
      status: "版权期",
      note: "看：色彩振动的一课——亮红的同心线与蓝绿线交替，方格在红底上时而凹陷、时而凸起；红绿互补色在等强度下让画面\"嗡嗡作响\"。藏：密歇根大学艺术博物馆。",
      link: "https://umma.umich.edu/objects/mercurius-in-the-vessel-1988-1-137/",
      linkLabel: "查看原作（密歇根大学藏品页）↗",
    },
  ],
  timeline: [
    { year: "1937", text: "瓦萨雷利画出《斑马》，被后人视为最早的欧普作品之一；当时他还在巴黎做商业平面设计。" },
    { year: "1959", text: "瓦萨雷利为\"塑料单元\"申请专利——把几何形与色彩编成可重复、可排列的系统。" },
    { year: "1961", text: "赖利画出《运动中的方形》，黑白时期的突破之作；次年在伦敦 Gallery One 举办首次个展。" },
    { year: "1964", text: "《时代》杂志创造\"Op Art\"一词；赖利完成《流》。" },
    { year: "1965", text: "MoMA《应答之眼》展览开幕，欧普艺术成为全球现象；《流》登上图录封面，瓦萨雷利被媒体称为\"欧普教皇\"。" },
    { year: "1968", text: "赖利在威尼斯双年展上获得国际绘画大奖，是第一位获此奖的在世英国画家与第一位女性；瓦萨雷利开始《织女星》系列的彩色阶段。" },
    { year: "1969", text: "瓦萨雷利《Vega-Nor》完成，成为欧普艺术最具代表性的图像之一；同年他的作品登上大卫·鲍伊专辑封面。" },
    { year: "1970 年代", text: "热潮退去，欧普的视觉语言进入平面设计、时尚、唱片封面与后来的数字动效。" },
  ],
  figures: [
    { name: "维克托·瓦萨雷利", note: "欧普艺术之父，几何系统与《织女星》系列的创造者。" },
    { name: "布里奇特·赖利", note: "黑白波浪线的大师，《应答之眼》的封面人物。" },
    { name: "理查德·安努斯凯维奇", note: "美国欧普的色彩派，互补色振动的探索者。" },
    { name: "赫苏斯·拉斐尔·索托", note: "委内瑞拉动能艺术家，把欧普从平面推向空间。" },
    { name: "朱利奥·勒·帕克", note: "阿根廷艺术家，欧普与光效、动能装置的连接者。" },
  ],
  influence: "从包豪斯的几何纪律与约瑟夫·阿尔伯斯的色彩研究中来，与极简主义、波普艺术同为 1960 年代纽约的平行浪潮；热潮退后，它的图案语言进入平面设计与时尚，莫尔纹与振动条纹至今是动效设计与生成艺术的常用母题。欧普艺术证明了一件事：视觉本身就可以是内容，不需要讲故事。",
  relatedStyles: [
    { name: "包豪斯", note: "几何与精确的源头", href: "/styles/bauhaus/" },
    { name: "风格派", note: "网格与原色的另一条路", href: "/styles/de-stijl/" },
