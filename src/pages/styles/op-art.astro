    { name: "孟菲斯", note: "图案与撞色的后继者", href: "/styles/memphis/" },
  ],
  relatedComponents: [
    { name: "首屏大图", note: "波浪线背景头图，需克制", href: "/components/entries/hero-section/" },
    { name: "图片轮播", note: "图案轮播", href: "/components/entries/image-carousel/" },
    { name: "引导轮播", note: "视觉动效引导页", href: "/components/entries/onboarding-carousel/" },
    { name: "分段控件", note: "黑白两极的高对比切换", href: "/components/entries/segmented-control/" },
  ],
  keywords: ["欧普艺术", "视幻艺术", "视觉幻觉", "瓦萨雷利", "赖利", "应答之眼", "莫尔纹", "黑白对比"],
  imageBg: "/brand/styles/op-art-bg.webp",
  imageAlt: "阿格莱亚身着欧普艺术风格：黑白螺旋与扭曲棋盘格，青绿点缀",
  heroTone: "light",
  footerNote: "草稿。画廊五件全部在版权期，一律只作文字 + 外链；《斑马》藏地与《织女星》系列起始年份在修订轮复核。英文全文翻译后补。",
