  timeline: [
    { year: "15 世纪", text: "村田珠光开创草庵茶，把茶从贵族书院的排场拉回简朴小室，侘茶的源头。" },
    { year: "15 世纪末", text: "龙安寺石庭建成（通说；年代与建造者有争议），枯山水成为禅宗美学的地标。" },
    { year: "16 世纪上半叶", text: "竹野绍鸥继承珠光，用日常器物入茶，进一步确立\"侘\"的品味。" },
    { year: "1570–1580 年代", text: "千利休请长次郎手捏茶碗，乐烧诞生；黑乐与赤乐成为侘茶的标准器物。" },
    { year: "1582", text: "待庵茶室建成，仅两张榻榻米，是利休侘茶最极致的建筑表达。" },
    { year: "1591", text: "利休被丰臣秀吉赐死；其后代分出表千家、里千家、武者小路千家三派，茶道制度化，侘寂随之传续。" },
    { year: "约 1595", text: "长谷川等伯画《松林图屏风》，侘寂从茶室走进绘画。" },
    { year: "20 世纪至今", text: "侘寂经陶艺、建筑与设计走向世界，成为慢生活与手作品牌的通用美学语言（现代传播的具体节点待补）。" },
  ],
  figures: [
    { name: "村田珠光", note: "草庵茶的开创者，侘茶的源头。" },
    { name: "竹野绍鸥", note: "利休之师，用日常器物确立侘的品味。" },
    { name: "千利休", note: "侘茶的完成者，待庵与乐烧背后的美学定型者。" },
    { name: "长次郎", note: "乐烧初代，手捏茶碗的制作者。" },
    { name: "长谷川等伯", note: "把侘寂画进屏风的画家，《松林图屏风》作者。" },
  ],
  influence: "从禅宗与茶道中来，与中国山水画的留白传统隔海呼应（等伯深受中国水墨影响）；向内影响了日本民艺运动对\"日常器物之美\"的发现，向外影响了 20 世纪西方陶艺与极简设计。侘寂不是一个有起止年份的\"运动\"，而是一种持续至今的审美态度——这正是它与本百科其他条目最大的不同。",
  relatedStyles: [
    { name: "民艺", note: "日常器物之美的继承者", href: "/styles/mingei/" },
