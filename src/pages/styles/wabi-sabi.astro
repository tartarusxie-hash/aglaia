    { name: "详情主视觉", note: "一物一页，偏置呈现", href: "/components/entries/detail-hero/" },
    { name: "图片轮播", note: "器物慢看，一次一件", href: "/components/entries/image-carousel/" },
    { name: "基础卡片", note: "素朴卡片，不堆装饰", href: "/components/entries/card-basic/" },
