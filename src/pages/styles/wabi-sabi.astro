    {
      label: "海报",
      zh: "用侘寂风格做一张茶室海报：一只手工黑乐茶碗偏置一角，大面积留白，陶土与灰调，金缮细线作唯一亮点，静谧克制。",
      en: "Design a tea house poster in wabi-sabi style: a single handmade black Raku tea bowl placed off-centre, vast negative space, clay and ash tones, one thin kintsugi gold line as the only highlight — quiet and restrained.",
    },
    {
      label: "品牌",
      zh: "用侘寂风格设计一个冥想 App 的视觉：米白底、苔藓绿点缀、粗糙纸纹、不对称排版，慢下来、不完美也没关系。",
      en: "Design a meditation app visual in wabi-sabi style: warm off-white ground, moss-green accents, rough paper texture, asymmetric layout — slow, calm, comfortable with imperfection.",
    },
    {
      label: "网页",
      zh: "用侘寂风格设计一个手作器物店的商品页：每件器物单独成页、居中偏置、留白极大，文字极少，让器物的裂纹与釉色自己说话。",
      en: "Design a handmade pottery shop product page in wabi-sabi style: one object per page, placed off-centre, huge margins, almost no text — let the cracks and glaze speak for themselves.",
    },
  ],
  palette: [
    { hex: "#8A5A3B", name: "陶土棕", role: "主色·器物与强调" },
    { hex: "#6B7A5A", name: "苔藓绿", role: "辅色·自然" },
    { hex: "#8E8B85", name: "灰", role: "中性·文字次级" },
    { hex: "#F2EDE3", name: "米白", role: "底色·纸与墙" },
    { hex: "#2B2620", name: "墨黑", role: "文字与线条" },
    { hex: "#C9A227", name: "金缮金", role: "点缀·仅用于修补线，极少量" },
  ],
  typography: "衬线为主，拒绝几何无衬线的冷感。日文/中文：Noto Serif JP / Noto Serif SC（OFL 开源，思源宋体）；英文标题：Cormorant Garamond（OFL 开源）；正文可用 Noto Serif 常规字重。标题可略大字距，营造呼吸感。",
  composition: ["偏置不对称，主体永远不在正中心", "留白极大，空白本身就是内容", "一页只讲一件事，不并排堆叠", "元素之间距离拉开，宁可空，不可满", "纵向留白多于横向"],
