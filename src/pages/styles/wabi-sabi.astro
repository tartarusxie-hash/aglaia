    { name: "中国水墨山水与宋式美学", note: "留白与禅意的源头之一", href: "/styles/chinese-landscape/" },
    { name: "极简主义", note: "常被混淆，需对照区分", href: "/styles/minimalism/" },
    { name: "工艺美术运动", note: "手工价值的西方呼应", href: "/styles/arts-and-crafts/" },
