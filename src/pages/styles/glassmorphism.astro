// 由合篇《关联数字风格》拆分而来，用户 2026-11-13 决定拆五篇。
const style = {
  id: "glassmorphism",
  nameZh: "玻璃拟态",
  nameEn: "Glassmorphism",
  years: "约 2020 年—（Liquid Glass 2025 年）",
  origin: "苹果与设计社区",
  definition: "玻璃拟态是磨砂玻璃质感的界面风格：半透明面板悬浮在鲜艳背景上，背景模糊、细亮边框，轻盈、通透、有深度。",
  definitionEn: "Glassmorphism is a frosted-glass interface style: translucent panels float over a vibrant background, with backdrop blur and thin light borders — airy, luminous, layered.",
  intro: [
    "玻璃拟态回答的是扁平化之后的问题：屏幕上的深度怎么做。它的答案是\"材质\"——不画阴影堆纸片，而是让面板本身变成一块磨砂玻璃：背景模糊、半透明填充、细亮边框，面板悬浮在鲜艳渐变之上，底下的色彩透过模糊层晕染出来，深度就有了。",
    "这块玻璃的源头是两个系统：苹果 iOS 7（2013）的模糊层与微软 Windows Acrylic（Fluent Design，2017）。2020 年它正式登场：米哈乌·马莱维奇 11 月 22 日在 UX Collective 发表《Glassmorphism in user interfaces》，为这种风格命名；同一个月，macOS Big Sur 把磨砂玻璃面板带进主流系统。2021 年 Windows 11 进一步把 Acrylic 与 Mica 写进 Fluent 材质体系。2025 年，苹果在 WWDC 发布 Liquid Glass（iOS 26 等），玻璃拟态被系统化——不再只是模糊，而是\"会弯曲光线的玻璃\"：实时折射、高光随动。",
    "玻璃拟态的定位很清楚：它是材质，不是系统。做氛围用它——播放页、控制中心、悬浮导航；做整套产品规则，另有质感设计。它的成败系于两件事：底下必须有东西可模糊（纯色底上玻璃无从谈起），面板上的文字必须保证对比度（加深填充或加阴影）。",
  ],
  promptZh: "用玻璃拟态风格设计一个音乐 App 的播放页：鲜艳渐变背景上悬浮磨砂玻璃面板、背景模糊、半透明填充、细亮边框，轻盈、通透、有深度。",
  promptEn: "Design a music app now-playing screen in glassmorphism style: frosted glass panels floating over a vibrant gradient background, backdrop blur, translucent fill, thin light borders — airy, luminous, layered.",
  variants: [
    {
      label: "产品",
      zh: "用玻璃拟态风格做一个天气 App 的首页：鲜艳渐变天空底 + 悬浮磨砂玻璃卡片，卡片上是今日温度与逐小时预报，背景模糊、细亮边框，清透、有层次。",
      en: "Build a weather app home screen in glassmorphism style: frosted glass cards floating over a vibrant gradient sky, showing today's temperature and the hourly forecast, backdrop blur, thin light borders — clear, luminous, layered.",
    },
    {
      label: "产品",
      zh: "用玻璃拟态风格设计一个金融 App 的仪表盘：深色渐变底 + 半透明玻璃面板卡片，余额与走势图悬浮其上，细亮边框、文字对比度充足，克制、通透、可信。",
      en: "Design a finance app dashboard in glassmorphism style: translucent glass-panel cards over a dark gradient, balance and charts floating on top, thin light borders, text contrast fully legible — restrained, luminous, trustworthy.",
    },
    {
      label: "网页",
      zh: "用玻璃拟态风格做一个着陆页的登录区：全幅鲜艳渐变背景中央悬浮一块磨砂玻璃登录卡，输入框与按钮都在玻璃上，背景模糊、光边细亮，轻盈、现代、有深度。",
      en: "Design a landing page login section in glassmorphism style: a frosted glass login card floating at the center of a full-bleed vibrant gradient, inputs and button on the glass, backdrop blur, thin glowing borders — airy, modern, layered.",
    },
  ],
  palette: [
    { hex: "#FFFFFF", name: "玻璃白", role: "半透明填充（须以半透明 + 背景模糊使用）" },
    { hex: "#8B5CF6", name: "渐变紫", role: "鲜艳渐变底" },
    { hex: "#3B82F6", name: "渐变蓝", role: "鲜艳渐变底" },
    { hex: "#EC4899", name: "渐变粉", role: "鲜艳渐变底" },
    { hex: "#111827", name: "深墨底", role: "深色模式下的底色" },
    { hex: "#FFFFFF", name: "光边白", role: "细亮边框，高不透明度白" },
  ],
  typography: "细无衬线 Inter（OFL）或 Poppins（OFL）。",
  composition: ["鲜艳渐变底 + 半透明面板悬浮其上", "面板居中或分层错落", "底下色彩透过模糊层晕染"],
  forms: "圆角面板、细亮边框；面板边缘带一圈细光，像玻璃被\"切\"出来的断面。",
