---
import StylePage from "../../views/StylePage.astro";

// 风格派条目 v0.1（2026-11-13）。正文见 workspace/goals/figma/entries/de-stijl-2026-11-13.md。
const style = {
  id: "de-stijl",
  nameZh: "风格派",
  nameEn: "De Stijl",
  years: "1917–1931",
  origin: "荷兰莱顿",
  definition: "风格派是荷兰艺术运动（1917–1931），只用三原色、黑白灰与横竖直线，追求普遍和谐。",
  definitionEn: "De Stijl was a Dutch art movement (1917–1931) that built a universal visual language from primary colors, black, white and grey, using only horizontal and vertical lines.",
  intro: [
    "1917 年，画家特奥·范·杜斯堡在荷兰莱顿创办同名杂志《风格派》，召集蒙德里安、里特维尔德、奥德、范·德·莱克、胡萨尔等画家与建筑师。他们的目标是乌托邦式的：抛开一切个人与民族的装饰，用最基本的视觉元素——直线、直角、矩形、三原色——建立一种放之四海而皆准的和谐语言。蒙德里安把这套绘画理论称为\"新造型主义\"。",
    "风格派的限定极为严格：配色只许红、黄、蓝三原色加黑、白、灰；线条只许水平与垂直，拒绝曲线与对角线；构图靠非对称平衡取胜，画面不对称，却处处平衡。范·杜斯堡后期打破了这条戒律，引入对角线，称之为\"元素主义\"，蒙德里安为此在 1925 年退出杂志。",
    "今天我们习以为常的网格排版、色块分区、模块化界面，源头之一就在这里。风格派把绘画的网格变成了设计的方法：先画格子，再填色块，秩序本身就是美。",
  ],
  promptZh: "用风格派设计一个 App 首页：黑线网格划分矩形色块、三原色（红、黄、蓝）平涂、非对称平衡，理性、秩序、安静。",
  promptEn: "Design an app home screen in De Stijl style: a black-line grid dividing rectangular color blocks, flat primary colors (red, yellow, blue), asymmetric balance — rational, orderly, calm.",
  variants: [
    {
      label: "海报",
      zh: "用风格派做一张展览海报：粗黑横竖线切分画面，一块大红、一块小黄点缀，大量留白，几何无衬线标题，冷静、克制。",
      en: "Design an exhibition poster in De Stijl style: thick black horizontal and vertical lines dividing the page, one large red block and one small yellow accent, generous white space, geometric sans-serif headline — calm and restrained.",
    },
    {
      label: "仪表盘",
      zh: "用风格派设计一个数据仪表盘：严格的矩形网格、每个模块一块纯色或留白、黑线分隔、不用圆角，清晰、高效。",
      en: "Design a data dashboard in De Stijl style: a strict rectangular grid, each module one flat color or white space, black dividing lines, no rounded corners — clear and efficient.",
    },
    {
      label: "品牌",
      zh: "用风格派设计一个家具品牌的视觉识别：红黄蓝三原色矩形标志、黑白网格排版、几何无衬线字体，现代、理性、有一点玩心。",
      en: "Design a furniture brand identity in De Stijl style: a logo of red, yellow and blue rectangles, black-and-white grid layout, geometric sans-serif type — modern, rational, with a touch of playfulness.",
    },
  ],
  palette: [
    { hex: "#DA291C", name: "风格派红", role: "主色·强调" },
    { hex: "#FFC72C", name: "风格派黄", role: "主色·点缀" },
    { hex: "#1E4FA3", name: "风格派蓝", role: "主色·结构" },
    { hex: "#111111", name: "曜黑", role: "线条与文字" },
    { hex: "#FFFFFF", name: "亮白", role: "底色" },
    { hex: "#9A9A9A", name: "中灰", role: "次要色块与次要文字" },
  ],
  typography: "几何无衬线是唯一选择。开源优先：Jost（OFL，与 1920 年代几何无衬线同一精神）、Poppins / Montserrat（OFL，标题可用）；正文 Inter（OFL）。标题可全大写、字距拉开；拒绝衬线体与手写体。",
  composition: ["非对称平衡的网格是核心", "黑线先定骨架，再填色块", "大面积留白，只用一两块原色点缀", "所有元素对齐网格线，不许随意摆放", "色块大小悬殊，形成主次"],
  forms: "只用直线、直角、矩形与正方形；拒绝曲线与对角线（范·杜斯堡后期引入对角线称\"元素主义\"，属运动后期的修正，不在本风格卡默认规则内）；拒绝圆角。",
  texture: "平涂、无笔触、无渐变；黑线网格、原色矩形、留白；家具与建筑里的平面穿插（红蓝椅、施罗德住宅）。",
  donts: ["不用曲线、对角线与圆角", "不用三原色之外的彩色（不用粉彩、不用霓虹）", "不用渐变、阴影、拟物材质", "不用装饰性衬线字体", "不把画面填满——留白是风格的一部分"],
