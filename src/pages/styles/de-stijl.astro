      note: "看：晚年的蒙德里安到了纽约，黑线消失了，换成一格格红黄蓝小方块跳成的爵士乐——网格还在，节奏变了。藏：纽约现代艺术博物馆。",
      link: "https://en.wikipedia.org/wiki/Broadway_Boogie-Woogie",
      linkLabel: "查看介绍（Wikipedia）↗",
    },
    {
      title: "里特维尔德《红蓝椅》",
      artist: "格里特·里特维尔德",
      year: "1918",
      status: "版权期",
      note: "看：风格派第一次走进三维——一张椅子只剩直线、平面与三原色；初版其实是原木色，约 1923 年后才漆上红蓝黄黑。",
      link: "https://high.org/collection/red-blue-chair/?ver=1.20.2",
      linkLabel: "查看藏品（High Museum）↗",
    },
    {
      title: "里特维尔德，施罗德住宅",
      artist: "格里特·里特维尔德",
      year: "1924",
      status: "版权期",
      note: "看：一栋住人的风格派绘画——平面穿插、活动隔墙、原色点缀；2000 年列入联合国教科文组织世界遗产。",
      link: "https://whc.unesco.org/en/list/965",
      linkLabel: "查看介绍（UNESCO）↗",
    },
    {
      title: "范·杜斯堡《构成 VII（三美神）》",
      artist: "特奥·范·杜斯堡",
      year: "1917",
      status: "公版",
      note: "看：运动元年的作品——古典题材\"三美神\"被拆成黑底上亮色的矩形条，人物消失了，只剩节奏。藏：圣路易斯 Mildred Lane Kemper 美术馆。",
      link: "https://www.kemperartmuseum.wustl.edu/collection/search-results/wu-3812-theo-van-doesburg-dutch-18831931-compositie-vii-de-drie-gratien-composition-vii-the-three-graces-1917",
      linkLabel: "查看藏品（Kemper Art Museum）↗",
    },
  ],
  timeline: [
    { year: "1917", text: "范·杜斯堡在莱顿创办《风格派》杂志（10 月第一期）；蒙德里安提出\"新造型主义\"，在杂志连载 12 篇文章；范·杜斯堡画《构成 VII（三美神）》。" },
    { year: "1918", text: "里特维尔德加入风格派，设计红蓝椅（初版原木色，约 1923 年后才漆上红蓝黄黑）。" },
    { year: "1921", text: "蒙德里安画《红、黄、蓝与黑的构图》，黑线网格 + 原色块的成熟语言成型。" },
    { year: "1924", text: "施罗德住宅在乌得勒支落成，风格派从绘画走进建筑；同年范·杜斯堡开始《反构成》系列，引入对角线。" },
    { year: "1925", text: "对角线之争——范·杜斯堡发展\"元素主义\"，蒙德里安认为对角线背叛了风格派，退出杂志。" },
    { year: "1928", text: "范·杜斯堡与阿尔普夫妇完成斯特拉斯堡奥贝特咖啡馆室内设计，45 度倾斜的色块是元素主义的代表作。" },
    { year: "1931", text: "范·杜斯堡在瑞士达沃斯去世，运动失去组织核心。" },
    { year: "1932", text: "杂志出版最后一期纪念号后停刊，风格派作为运动落幕。" },
  ],
  figures: [
    { name: "皮特·蒙德里安", note: "新造型主义的理论家与最著名的画家，网格 + 原色的语言由他定型。" },
    { name: "特奥·范·杜斯堡", note: "运动的创始人与杂志主编，后期以元素主义引入对角线。" },
    { name: "格里特·里特维尔德", note: "建筑师与家具设计师，把风格派做成椅子与住宅。" },
    { name: "巴特·范·德·莱克", note: "创始画家之一，早期成员。" },
    { name: "维尔莫什·胡萨尔", note: "创始画家兼版式设计师，设计了杂志的刊头。" },
  ],
  influence: "从立体主义的几何简化中来，与包豪斯、构成主义平行发展、互相影响；网格与非对称平衡经瑞士风格进入现代平面设计，成为今天 UI 网格系统的源头之一；蒙德里安晚年移居纽约，《百老汇爵士乐》影响了美国抽象艺术；施罗德住宅 2000 年列入世界遗产，风格派的建筑遗产至今仍在被参观与研究。",
  relatedStyles: [
    { name: "包豪斯", note: "几何与原色的另一条路，平行发展", href: "/styles/bauhaus/" },
    { name: "构成主义", note: "俄国，红黑几何与斜线" },
    { name: "瑞士风格", note: "风格派网格的直接继承者", href: "/styles/swiss-style/" },
    { name: "极简主义", note: "更彻底的减法", href: "/styles/minimalism/" },
    { name: "扁平化设计", note: "数字时代的平涂与网格", href: "/styles/flat-design/" },
  ],
  relatedComponents: [
    { name: "仪表盘卡片", note: "模块化色块", href: "/components/entries/dashboard-cards/" },
    { name: "数据表格", note: "网格与对齐", href: "/components/entries/data-table/" },
    { name: "定价表", note: "矩形分区", href: "/components/entries/pricing-table/" },
    { name: "基础卡片", note: "色块分区", href: "/components/entries/card-basic/" },
  ],
  keywords: ["风格派", "新造型主义", "蒙德里安", "网格", "三原色", "非对称平衡", "里特维尔德", "范·杜斯堡"],
  imageBg: "/brand/styles/de-stijl-bg.webp",
  imageAlt: "阿格莱亚身着风格派：蒙德里安网格，黑线与红黄蓝矩形",
  heroTone: "light",
  footerNote: "草稿。画廊三幅公版作品的图片在发布时自托管；两幅版权期作品只放文字介绍 + 外链。英文全文翻译后补。",
};
