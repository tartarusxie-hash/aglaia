---
import StylePage from "../../views/StylePage.astro";

// 后印象派条目 v0.1（2026-11-13）。正文见 workspace/goals/figma/entries/post-impressionism-2026-11-13.md。
const style = {
  id: "post-impressionism",
  nameZh: "后印象派",
  nameEn: "Post-Impressionism",
  years: "约 1886–1905 年",
  origin: "法国",
  definition: "1886–1905 年法国画派，继承印象派的亮色，却以结构、情感与象征超越光学表象。",
  definitionEn: "A French movement (1886–1905) that kept Impressionism's bright colour but went beyond optical appearance toward structure, emotion and symbol.",
  intro: [
    "后印象派不是一个有共同宣言的团体，而是一批各自走出印象派的画家合起来的名字。他们都觉得：只记录光学表象不够。于是塞尚走向结构——用圆柱、球体、圆锥概括自然，要把印象派\"变得像博物馆里的艺术一样坚实耐久\"；梵高走向情感——用旋转的厚涂笔触与铬黄、钴蓝的强烈对比画内心的感受；高更走向象征——用平涂的热带色彩画神话与原始生活；修拉走向色彩科学——用无数小色点让颜色在观者眼中混合。",
    "这个词是后来安上的。英国批评家罗杰·弗莱 1906 年首次使用\"后印象派\"一词，1910 年又以《马奈与后印象派》为题在伦敦办展，正式确立了这个名字。弗莱自己也承认，这名字\"只是说明他们在时间上处于印象派之后\"，并没有说他们是一派。",
    "后印象派是 20 世纪现代艺术的分水岭：塞尚通向立体主义，梵高与高更通向野兽派与表现主义，修拉的点彩通向新印象主义。四条路从这里分岔，现代艺术从此不再只有一条大道。",
  ],
  promptZh: "用后印象派风格设计一个 App 插画：梵高式的旋转厚涂笔触、铬黄与钴蓝的强烈对比、星空与柏树，情感浓烈、笔触可见、像一幅会呼吸的画。",
  promptEn: "Design an app illustration in Post-Impressionist style: Van Gogh-style swirling impasto brushstrokes, strong contrast of chrome yellow and cobalt blue, a starry sky with cypress trees — emotional, tactile, like a painting that breathes.",
  variants: [
    {
      label: "海报",
      zh: "用后印象派风格做一张旅行海报：高更式的平涂热带色块、棕榈与海面、装饰性平面构图，热烈而宁静。",
      en: "Design a travel poster in Post-Impressionist style: Gauguin-style flat tropical color blocks, palms and sea, decorative flat composition — warm and calm.",
    },
    {
      label: "品牌",
      zh: "用后印象派风格设计一个咖啡品牌的视觉：塞尚式的几何概括——圆、柱、锥构成静物，暖赭与深绿，沉稳有结构感。",
      en: "Design a coffee brand visual in Post-Impressionist style: Cézanne-like geometric still life — cylinders, spheres and cones, warm ochre and deep green — solid and structured.",
    },
    {
      label: "网页",
      zh: "用后印象派风格设计一个作品集网站背景：修拉式的点彩小点阵列、互补色并置、像素感纹理，理性中带一点手工温度。",
      en: "Design a portfolio website background in Post-Impressionist style: Seurat-like pointillist dot arrays, juxtaposed complementary colors, pixel-like texture — systematic, with a handmade warmth.",
    },
  ],
  palette: [
    { hex: "#F2B705", name: "铬黄", role: "主色·梵高的黄" },
    { hex: "#0047AB", name: "钴蓝", role: "主色·与黄对比" },
    { hex: "#E8722A", name: "赭橙", role: "辅色·暖调点缀" },
    { hex: "#2E7D5B", name: "热带绿", role: "辅色·高更的热带" },
    { hex: "#A63D2F", name: "陶土红", role: "点缀·高更的土红" },
    { hex: "#F5EDDC", name: "米白", role: "底色·画布底" },
  ],
  typography: "绘画运动本身无字体倾向，以下为氛围转译推荐。标题：Fraunces（OFL，有手写感与旧式衬线的温度，配梵高式的情感浓度）；正文：Inter（OFL）。需要装饰性标题时可用 DM Serif Display（OFL）。避免冷峻的纯几何无衬线。",
  composition: ["强调结构与装饰性平面：塞尚式——用几何体组织画面，元素归整到稳定的三角/金字塔结构", "高更式——平涂色块分区，前景、中景、背景像剪纸一样叠置", "留出\"呼吸的空地\"，忌满铺"],
  forms: "两极并存：塞尚的几何概括（圆柱、球体、圆锥）与梵高的旋转笔触（旋涡、火焰形）；高更的平涂剪影形态；修拉的圆点阵列。形态服务于情感或结构，不追求写实。",
  texture: "质感分两极——厚涂旋涡笔触（梵高）与点彩小点（修拉）；反复母题：旋转的星空、向日葵、圣维克多山、热带人物与棕榈、塞纳河畔的周日人群。",
  donts: ["不要只学\"梵高滤镜\"式的旋转笔触而丢掉结构——后印象派是四条路，不是只有梵高一条", "不用印象派式的朦胧消解（这里轮廓与结构要站得住）", "不用写实透视与学院派明暗", "点彩密度不要太高（小尺寸下会糊成一片灰）"],
  gallery: [
    {
      title: "梵高《星夜》",
      artist: "文森特·梵高",
      year: "1889",
      status: "公版",
      note: "看：后印象派最著名的\"情感压倒眼睛\"——圣雷米疗养院窗外的夜空被画成旋转的旋涡，柏树像火焰，村庄是凭想象加上的。藏：纽约现代艺术博物馆。",
      link: "https://en.wikipedia.org/wiki/The_Starry_Night",
      linkLabel: "查看介绍（Wikipedia）↗",
    },
    {
      title: "梵高《向日葵》系列",
      artist: "文森特·梵高",
      year: "1888",
      status: "公版",
      note: "看：黄色的宣言——第四版（伦敦国家美术馆藏）是\"黄上加黄\"，花、花瓶、背景全是不同层次的黄，专为迎接高更来访而画，挂在阿尔勒\"黄房子\"的客房里。藏：伦敦国家美术馆（第四版）等。",
      link: "https://en.wikipedia.org/wiki/Sunflowers_(Van_Gogh_series)",
      linkLabel: "查看介绍（Wikipedia）↗",
    },
    {
      title: "塞尚《圣维克多山》系列",
      artist: "保罗·塞尚",
      year: "1882–1906",
      status: "公版",
      note: "看：同一座山画了八十多次——山体被还原成几何体，色彩按结构分块；立体主义就是从这里出发的。藏：奥赛美术馆、大都会艺术博物馆、费城美术馆等多家。",
      link: "https://en.wikipedia.org/wiki/Mont_Sainte-Victoire_%28C%C3%A9zanne%29",
      linkLabel: "查看介绍（Wikipedia）↗",
    },
    {
      title: "修拉《大碗岛的星期天下午》",
      artist: "乔治·修拉",
      year: "1884–1886",
      status: "公版",
      note: "看：点彩法的巅峰之作——整幅 2×3 米的大画全由小色点构成，颜色在观者眼中混合；1886 年第八次印象派展览上的压轴之作。藏：芝加哥艺术学院。",
      link: "https://en.wikipedia.org/wiki/A_Sunday_Afternoon_on_the_Island_of_La_Grande_Jatte",
      linkLabel: "查看介绍（Wikipedia）↗",
    },
    {
      title: "高更《我们从哪里来？我们是谁？我们往哪里去？》",
      artist: "保罗·高更",
      year: "1897–1898",
      status: "公版",
      note: "看：高更自认的\"遗言之作\"——近四米长的横幅，从右向左读：婴儿、壮年、老妇，对应生、活、死；标题就写在画面左上角的黄色块上。藏：波士顿美术博物馆。",
      link: "https://en.wikipedia.org/wiki/Where_Do_We_Come_From%3F_What_Are_We%3F_Where_Are_We_Going%3F",
      linkLabel: "查看介绍（Wikipedia）↗",
    },
  ],
  timeline: [
    { year: "1884", text: "修拉开始画《大碗岛的星期天下午》，并参与创立独立艺术家协会。" },
    { year: "1886", text: "第八次、也是最后一次印象派展览；修拉的《大碗岛》在展上亮相，后印象派以此为起点。" },
    { year: "1888", text: "梵高在阿尔勒画《向日葵》系列；10 月高更抵达阿尔勒，两人共居\"黄房子\"，两个月后决裂。" },
    { year: "1889", text: "梵高在圣雷米疗养院画《星夜》（6 月）；同年沃尔皮尼咖啡馆展览上，高更与贝尔纳的作品被冠以\"综合主义\"之名。" },
    { year: "1890–1891", text: "梵高逝世（1890 年，37 岁）；修拉逝世（1891 年，31 岁）。后印象派的两位最年轻的旗手相继早逝。" },
    { year: "1891–1893", text: "高更第一次塔希提之行（1891–1893），后于 1895–1901 年第二次前往。" },
    { year: "1897–1898", text: "高更在塔希提画《我们从哪里来？我们是谁？我们往哪里去？》，自视为毕生代表作。" },
    { year: "1905–1906", text: "1905 年秋季沙龙上野兽派横空出世，后印象派的年代以此为终点；1906 年塞尚逝世，1907 年秋季沙龙为他办大型回顾展。" },
    { year: "1906 / 1910", text: "罗杰·弗莱 1906 年首次使用\"后印象派\"一词；1910 年在伦敦格拉夫顿画廊策划《马奈与后印象派》展，术语正式确立。" },
  ],
  figures: [
    { name: "保罗·塞尚", note: "\"后印象派之父\"，用几何体概括自然，直接启发了立体主义。" },
    { name: "文森特·梵高", note: "用旋转笔触与强烈色彩画情感，《星夜》与《向日葵》的作者。" },
    { name: "保罗·高更", note: "走向象征与原始主义，平涂热带色彩的开创者。" },
    { name: "乔治·修拉", note: "点彩法的创始人，以色彩科学改造印象派。" },
    { name: "亨利·德·图卢兹-罗特列克", note: "画巴黎夜生活与海报，把后印象派带进平面设计。" },
  ],
  influence: "从印象派中来——继承了亮色与户外写生，反对的只是\"只记录光学表象\"。它没有统一的下一站，而是四条分岔：塞尚通向立体主义，梵高与高更通向野兽派与表现主义，修拉通向新印象主义与抽象；图卢兹-罗特列克则把绘画语言带进海报与平面设计。可以说，整个 20 世纪前半叶的现代艺术，都是后印象派的续篇。",
  relatedStyles: [
    { name: "印象派", note: "源头", href: "/styles/impressionism/" },
    { name: "野兽派", note: "梵高与高更的色彩解放的下一站", href: "/styles/fauvism/" },
    { name: "立体主义", note: "塞尚的直接继承者" },
    { name: "表现主义", note: "梵高的情感表达在德国的回响" },
    { name: "新艺术运动", note: "同时代的装饰性平面语言", href: "/styles/art-nouveau/" },
  ],
  relatedComponents: [
    { name: "主视觉区", note: "星夜式情绪首屏", href: "/components/entries/hero-section/" },
    { name: "图片轮播", note: "画作轮播", href: "/components/entries/image-carousel/" },
    { name: "瀑布流", note: "画廊瀑布流", href: "/components/entries/masonry-grid/" },
    { name: "引导轮播", note: "点彩引导页", href: "/components/entries/onboarding-carousel/" },
    { name: "商品卡片", note: "高饱和商品卡", href: "/components/entries/product-card/" },
  ],
  keywords: ["后印象派", "梵高", "塞尚", "高更", "修拉", "点彩", "星夜", "向日葵", "结构与情感"],
  imageBg: "/brand/styles/post-impressionism-bg.webp",
  imageAlt: "阿格莱亚身着后印象派风格：普罗旺斯露台，柏树与旋转笔触的深蓝夜空",
  heroTone: "dark",
  footerNote: "草稿。画廊五幅作品均为公版，发布时从 Wikimedia Commons 取图自托管。英文全文翻译后补。",
};
