      en: "Design an artist portfolio homepage in Abstract Expressionist style: a color-field background in deep red and ochre yellow, text laid over the color blocks, no visible grid — emotion first, let the color speak.",
    },
  ],
  palette: [
    { hex: "#1A1A1A", name: "墨黑", role: "线条主色·行动绘画" },
    { hex: "#F2EDE3", name: "米白", role: "画布底色" },
    { hex: "#8A5A2B", name: "赭石棕", role: "行动绘画暖调" },
    { hex: "#8C2B1E", name: "深红", role: "色域主色" },
