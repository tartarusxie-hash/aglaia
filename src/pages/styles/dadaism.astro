---
import StylePage from "../../views/StylePage.astro";

// 达达主义条目 v0.1（2026-11-13）。正文见 workspace/goals/figma/entries/dadaism-2026-11-13.md。
const style = {
  id: "dadaism",
  nameZh: "达达主义",
  nameEn: "Dadaism",
  years: "约 1916–1924 年",
  origin: "瑞士苏黎世",
  definition: "达达主义是 1916 年苏黎世的反艺术运动，用拼贴、现成品与荒诞回应一战的荒谬。",
  definitionEn: "Dada was an anti-art movement born in Zurich in 1916, answering the absurdity of World War I with collage, readymades and absurdity.",
  intro: [
    "1916 年 2 月 5 日，胡戈·巴尔与艾米·亨宁斯在苏黎世开设伏尔泰酒馆，流亡的艺术家们每晚在此表演、朗诵、胡闹——达达就此诞生。同年 7 月 14 日，巴尔发表第一篇达达宣言；1918 年，查拉发表了更著名的第二篇。",
    "达达的核心判断是：既然理性文明导致了一战的屠杀，艺术就应拥抱荒诞、偶然与无意义。手段包括杜尚的现成品、柏林的照相蒙太奇、阿尔普的偶然拼贴、查拉的剪报诗。杜尚的《泉》质疑了\"什么是艺术\"的定义本身：一件东西是不是艺术，不取决于它怎么做，而取决于艺术家指着它说\"是\"。",
    "运动扩散至柏林、巴黎、纽约，约 1924 年收束——1924 年布勒东发表《超现实主义宣言》，巴黎的达达圈子转向超现实主义。但达达的反设计、拼贴与\"故意丑\"在朋克、故障风与实验品牌中一直活着。",
  ],
  promptZh: "用达达主义风格设计一个 App 启动页：拼贴式构图、随机排布的文字碎片、黑白照片与亮色色块并置，带一点荒诞和玩笑感。",
  promptEn: "Design an app launch screen in Dada style: collage composition, randomly arranged text fragments, black-and-white photos set against bright color blocks — a touch of absurdity and playfulness.",
  variants: [
    {
      label: "海报",
      zh: "用达达主义风格做一张独立音乐节海报：报纸剪贴的'赎金信式'混排标题、照相蒙太奇、黑白加一抹亮色，拒绝网格、越乱越好。",
      en: "Design an indie music festival poster in Dada style: a ransom-note headline cut from newspapers, photomontage, black and white with one bright color — no grid, the messier the better.",
    },
    {
      label: "品牌",
      zh: "用达达主义风格设计一个先锋咖啡品牌的视觉识别：现成品拼贴、随机碎片、错位排版，反精致、反正确，好玩第一。",
      en: "Design an avant-garde coffee brand identity in Dada style: readymade collage, random fragments, misaligned layout — anti-polish, anti-correct, fun first.",
    },
    {
      label: "网页",
      zh: "用达达主义风格设计一个实验性作品集网站首页：元素随机散落、文字可大可小、留白即兴，像一张被风吹乱的报纸。",
      en: "Design an experimental portfolio homepage in Dada style: elements scattered at random, type in any size, improvised white space — like a newspaper blown apart by the wind.",
    },
  ],
  palette: [
    { hex: "#1A1A1A", name: "报纸黑", role: "主色·文字与拼贴底" },
    { hex: "#F2EFE6", name: "纸白", role: "底色·旧报纸" },
    { hex: "#9A958A", name: "灰", role: "辅色·照片灰调" },
    { hex: "#D9381E", name: "亮红", role: "点缀·偶然色彩" },
    { hex: "#2456C8", name: "亮蓝", role: "点缀·偶然色彩" },
    { hex: "#E8B90F", name: "黄", role: "点缀·偶然色彩" },
  ],
  typography: "报纸剪贴的\"赎金信式\"混排是本法——同一标题混用 2–3 种字体与字号。开源字体：标题混用 Anton（OFL，大写粗黑）+ Playfair Display（OFL，衬线）+ Special Elite（OFL，打字机体）；正文 Inter（OFL）。",
  composition: ["拒绝网格", "随机拼贴、错位、重叠", "留白即兴", "元素可斜置、可出界", "但要留一个视觉锚点（否则只是乱）"],
  forms: "挪用图像、现成品、随机碎片；剪报边缘、撕纸、图钉；大小悬殊的并置（巨型字母 + 微小照片）。",
  texture: "报纸、票据、包装纸等现成材料；照相蒙太奇；剪报诗；小便池、瓶架等现成品的幽灵；荒诞并置。",
  donts: ["不用整齐的网格与统一的字阶（那是达达的敌人）", "不用精致的渐变与柔和配色", "不用\"有意义\"的隐喻——达达的并置就是不要意义", "不为乱而乱到读不懂（至少留一条可读的线索）"],
  gallery: [
    {
      title: "杜尚《泉》",
      artist: "马塞尔·杜尚",
