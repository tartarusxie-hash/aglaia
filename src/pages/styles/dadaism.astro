    { name: "空状态", note: "\"什么都没有\"本身就是达达", href: "/components/entries/empty-state/" },
    { name: "图片轮播", note: "蒙太奇轮播", href: "/components/entries/image-carousel/" },
  ],
  keywords: ["达达主义", "反艺术", "拼贴", "现成品", "杜尚", "查拉", "照相蒙太奇", "荒诞"],
  imageBg: "/brand/styles/dadaism-bg.webp",
  imageAlt: "阿格莱亚身着达达主义风格：撕纸拼贴、巨型钥匙与齿轮，荒诞并置",
  heroTone: "light",
  footerNote: "草稿。画廊五件作品全部在版权期内，只放文字 + 外链，不直接放图。《泉》的版权状态与杜尚其他作品不同，发布前须复核。英文全文翻译后补。",
};
