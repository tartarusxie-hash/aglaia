  timeline: [
    { year: "2014 年 6 月", text: "谷歌在 Google I/O 2014 发布质感设计（杜阿尔特主讲），\"纸片海拔\"把深度带回规则。" },
    { year: "2014 年 11 月", text: "Android 5.0 Lollipop 正式推送（11 月 12 日），质感设计第一次落地到系统与应用；通知变卡片、最近任务变 3D 纸片叠。" },
    { year: "2018 年 5 月", text: "Google I/O 2018 推出 Material Theming（媒体俗称\"Material Design 2\"，谷歌从未用此作官方名）——色彩、字体、形状全面可定制，谷歌自家主题定为白色底面 + 四色点缀。" },
    { year: "2021 年", text: "Material 3 / Material You 发布（动态取色），随 Android 12（2021 年 10 月）上线；系统从壁纸取色，整机配色随壁纸而变。" },
    { year: "2022 年 2 月", text: "谷歌宣布 Material You 的动态取色扩展到更多 Android 12 手机，包括三星、一加、OPPO、vivo、realme、小米等厂商的设备。" },
  ],
  figures: [
    { name: "马蒂亚斯·杜阿尔特", note: "谷歌设计负责人，质感设计的主导者；2014 年在 Google I/O 上登台发布质感设计，2021 年又登台展示 Material You。" },
  ],
  influence: "从拟物化与扁平化的摆动中来。扁平化（2013）把深度拿走，质感设计（2014）把深度规则化——纸片、海拔、涟漪，一套可复制的语言。此后它的演变是\"规则不减，个性渐增\"：2018 年放开主题定制，2021 年用动态取色把个性交给每位用户。今天几乎所有主流设计系统都在\"扁平骨架 + 材质深度\"的混合态里，而质感设计是其中规则最全、落地最广的一套。",
  relatedStyles: [
    { name: "玻璃拟态", note: "扁平化之后另一条深度路线，模糊 + 半透明", href: "/styles/glassmorphism/" },
    { name: "黏土拟态", note: "新拟态的友好继任者，膨胀圆润的 3D 造型", href: "/styles/claymorphism/" },
    { name: "新拟态", note: "玻璃与黏土的直接前身", href: "/styles/neumorphism/" },
    { name: "扁平化设计", note: "2013 年的转折点，质感设计回应它", href: "/styles/flat-design/" },
