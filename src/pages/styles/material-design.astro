// 由合篇《关联数字风格》拆分而来，用户 2026-11-13 决定拆五篇。
const style = {
  id: "material-design",
  nameZh: "质感设计",
  nameEn: "Material Design",
  years: "2014 年—（Material 3 / Material You 2021 年—）",
  origin: "谷歌",
  definition: "界面是一叠有高度的\"纸片\"——海拔阴影定层级，涟漪动效回应触摸。",
  definitionEn: "The interface is a stack of paper sheets with real elevation — shadows set the hierarchy, ripples answer the touch.",
  intro: [
    "2014 年，谷歌在 Google I/O 上发布质感设计，把界面视为有高度的\"纸片\"，用海拔阴影、涟漪动效与大胆色彩建立层级——深度第一次有了完整的规则。它不是一种装饰，而是一套系统：网格、纸片、海拔、动效、色彩、字体，每一层都有章可循。扁平化（2013）把深度拿走之后，质感设计把深度带回了规则里。",
    "质感设计的演变是一条从统一到个性的路。2014 年的第一代以纸片与海拔立规矩；2018 年的 Material Theming（媒体俗称\"Material Design 2\"，并非谷歌官方名称）放开定制，允许每个产品用自己的色彩、字体与形状做主题；2021 年的 Material 3 / Material You 更进一步，用动态取色让系统从壁纸里取色，整部手机随一张图换装。规则最全的子风格，做产品用它——这是它在关联数字风格里的位置。",
  ],
  promptZh: "用质感设计风格做一个待办 App：纸片分层、海拔阴影定层级、圆形悬浮操作按钮、涟漪点击动效，干净、系统、有秩序。",
  promptEn: "Build a to-do app in Material Design style: layered paper surfaces, elevation shadows for hierarchy, a round floating action button, ripple tap effects — clean, systematic, orderly.",
  variants: [
    {
      label: "产品",
      zh: "用质感设计风格做一个新闻 App 的首页：卡片式信息流、纸片分层、海拔阴影区分头条与列表、圆形悬浮操作按钮，清晰、有层级、易扫读。",
      en: "Design a news app home screen in Material Design style: a card-based feed, layered paper surfaces, elevation shadows separating headlines from the list, a round floating action button — clear, layered, easy to scan.",
    },
    {
      label: "品牌",
      zh: "用质感设计风格做一个品牌官网的首页：白色纸面底、大号 Roboto 标题、圆角矩形卡片分层排列、海拔阴影定主次，克制、系统、可信。",
      en: "Design a brand website homepage in Material Design style: a white paper ground, large Roboto headlines, rounded-rectangle cards in layered rows, elevation shadows setting priority — restrained, systematic, trustworthy.",
    },
    {
      label: "仪表盘",
      zh: "用质感设计风格做一个数据仪表盘：指标卡片按海拔分层、关键数字用质感紫强调、涟漪动效回应每一次点击，秩序感强、一眼见重点。",
      en: "Design a data dashboard in Material Design style: metric cards layered by elevation, key numbers highlighted in Material purple, ripple effects answering every tap — strongly ordered, priorities visible at a glance.",
    },
  ],
  palette: [
    { hex: "#6750A4", name: "质感紫", role: "Material 3 基准种子色" },
    { hex: "#FFFFFF", name: "纸面白", role: "纸片底色" },
    { hex: "#212121", name: "墨色", role: "正文与标题" },
    { hex: "#4285F4", name: "谷歌蓝", role: "点缀" },
    { hex: "#34A853", name: "谷歌绿", role: "点缀" },
    { hex: "#EA4335", name: "谷歌红", role: "点缀" },
    { hex: "#FBBC04", name: "谷歌黄", role: "点缀" },
