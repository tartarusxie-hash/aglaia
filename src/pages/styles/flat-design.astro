---
import StylePage from "../../views/StylePage.astro";

// 扁平化设计条目 v0.1（2026-11-13）。正文见 workspace/goals/figma/entries/flat-design-2026-11-13.md。
const style = {
  id: "flat-design",
  nameZh: "扁平化设计",
  nameEn: "Flat Design",
  years: "约 2010 年至今",
  origin: "美国（微软、苹果）",
  definition: "扁平化设计是以纯色块、简洁几何与干净字体，彻底去掉阴影、渐变与纹理的二维界面风格。",
  definitionEn: "Flat design is a two-dimensional interface style built on solid color blocks, simple geometry and clean typography, stripping away shadows, gradients and textures entirely.",
  intro: [
    "扁平化设计诞生于 2010 年代初的美国。2010 年，微软随 Windows Phone 7 推出 Metro 设计语言，用大色块磁贴与大号字体取代了拟物化的立体质感；2012 年 Windows 8 把这套语言带上桌面。2013 年，苹果在乔纳森·艾维主导下发布 iOS 7，一夜之间扔掉了皮革、毡布与缝线——曾经最坚定的拟物化拥护者转了向，扁平化由此成为整个行业的默认语言。",
    "它的主张很直接：屏幕本来就是二维的，何必假装三维？去掉一切模拟深度的手法——阴影、渐变、倒角、材质纹理——只留纯色面、几何形与清晰的文字层级。它的血脉来自更早的现代主义：瑞士风格的网格与无衬线字体、包豪斯的几何与功能优先，只不过第一次完整地长在了触屏界面上。",
    "但纯扁平很快暴露出一个问题：按钮和文字长得一样，用户分不清哪里能点——可操作性不足。于是 2014 年起，谷歌的 Material Design 用\"纸片\"隐喻与海拔阴影给扁平加回了克制的层次；2015 年前后，Flat 2.0（半扁平）成型：保留纯色与简洁，只把细微阴影与柔和渐变用在需要表达层级与可点性的地方。今天我们日常用的界面，绝大多数其实都是半扁平，而不是纯扁平。",
  ],
  promptZh: "用扁平化风格设计一个天气 App 首页：纯色块与简洁几何图标、干净无衬线字体、网格化布局，清爽、轻快、一目了然。",
  promptEn: "Design a weather app home screen in flat design style: solid color blocks, simple geometric icons, clean sans-serif typography, a grid layout — fresh, light, instantly clear.",
  variants: [
    {
      label: "仪表盘",
      zh: "用扁平化风格设计一个健身数据仪表盘：纯色卡片分区、粗细对比的无衬线数字、一致的间距网格，干净、专注、有条理。",
      en: "Design a fitness data dashboard in flat design style: solid-color card sections, sans-serif numerals with bold-thin contrast, a consistent spacing grid — clean, focused, orderly.",
    },
    {
      label: "插画海报",
      zh: "用扁平化风格做一张城市旅行海报：大面积纯色块、几何化的建筑剪影、有限的明亮色板，轻松、明快、有海报感。",
      en: "Design a city travel poster in flat design style: large solid color blocks, geometric building silhouettes, a limited bright palette — relaxed, vivid, poster-like.",
    },
    {
      label: "换强度（Flat 2.0）",
      zh: "用半扁平（Flat 2.0）风格设计一个待办事项 App：纯色卡片加细微阴影、圆角几何图标、柔和的按钮渐变，简洁但摸得着层级。",
      en: "Design a to-do app in Flat 2.0 (semi-flat) style: solid-color cards with subtle shadows, rounded geometric icons, a soft button gradient — simple, with a touchable sense of hierarchy.",
    },
  ],
  palette: [
    { hex: "#3498DB", name: "亮蓝", role: "主色·按钮与链接" },
    { hex: "#2ECC71", name: "翠绿", role: "辅色·成功与点缀" },
    { hex: "#E74C3C", name: "珊瑚红", role: "辅色·提醒与强调" },
    { hex: "#F1C40F", name: "明黄", role: "点缀" },
    { hex: "#2C3E50", name: "深蓝灰", role: "文字与结构" },
    { hex: "#FFFFFF", name: "亮白", role: "底色" },
  ],
  typography: "干净无衬线是唯一选择，层级靠字号与字重，不靠装饰。推荐：Roboto（Apache 2.0 开源，Material Design 系统字体）；标题可用 Inter（OFL 开源）或 Poppins（OFL 开源）；中文用 Noto Sans SC（OFL 开源）。Metro 原用 Segoe UI（微软专有字体，需授权，不推荐）。",
  composition: ["严格网格化布局", "一致的间距与对齐", "内容优先，装饰为零", "大面积留白", "卡片分区代替分割线堆砌"],
  forms: "只用完美几何形——矩形、圆形、圆角矩形；线条笔直、边角利落；图标用最简的几何概括，线条粗细一致。",
  texture: "零质感：纯色面，无纹理、无噪点、无材质——这是扁平化最核心的识别点。母题：大色块、几何图标、色块分区、简洁的插画剪影。Flat 2.0 可在卡片与按钮上加细微阴影与柔和渐变，但只用于表达层级与可点性，不模拟真实材质。",
  donts: ["不用拟物材质（皮革、木纹、金属拉丝一律不要）", "不用厚重投影、斜角与浮雕", "不用写实图标", "不用衬线装饰字体", "不在纯扁平里加渐变与阴影（要加就明确做成 Flat 2.0，别半吊子）"],
  gallery: [
    {
      title: "Windows 8 Metro 界面",
      artist: "微软",
      year: "2012",
      status: "版权期（微软版权）",
      note: "看：扁平化的第一次完整亮相——大色块动态磁贴铺满开始屏幕，文字本身就是视觉主体，内容压过装饰。",
      link: "https://en.wikipedia.org/wiki/Metro_(design_language)",
      linkLabel: "查看介绍（Wikipedia）↗",
    },
    {
      title: "iOS 7 界面",
      artist: "苹果",
      year: "2013",
