    { name: "扁平化设计", note: "被反叛的对象，黏土是对扁平的柔软回应", href: "/styles/flat-design/" },
  ],
  relatedComponents: [
    { name: "商品卡片", note: "黏土膨胀造型", href: "/components/entries/product-card/" },
    { name: "基础卡片", note: "黏土圆顶卡片", href: "/components/entries/card-basic/" },
    { name: "底部抽屉", note: "圆润抽屉面板", href: "/components/entries/bottom-sheet/" },
    { name: "移动端底部导航", note: "悬浮黏土导航条", href: "/components/entries/mobile-tab-bar/" },
    { name: "英雄区", note: "黏土 3D 插画氛围", href: "/components/entries/hero-section/" },
  ],
  keywords: ["黏土拟态", "Claymorphism", "新拟态", "内阴影", "深外阴影", "膨胀 3D", "粉彩"],
  imageBg: "/brand/styles/claymorphism-bg.webp",
  imageAlt: "阿格莱亚身着黏土拟态风格：吹胀的圆润黏土云朵与柔和粉彩",
  heroTone: "light",
  footerNote: "草稿。命名文章准确发布日未定（原文页无日期，有第三方笔记称 2021 年 12 月 20 日，未取单方说法，正文只写 2021 年 12 月）；clay.css 上 Product Hunt 的日期仅来自搜索摘要；Dribbble 标签页验证时返回的是 2025-03-06 的缓存页，内容以实时页面为准。英文全文翻译后补。",
};
