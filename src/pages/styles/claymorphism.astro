// 黏土拟态条目 v0.1（2026-11-13）。正文见 workspace/goals/figma/entries/claymorphism-2026-11-13.md。
// 由合篇《关联数字风格》拆分而来，用户 2026-11-13 决定拆五篇。
const style = {
  id: "claymorphism",
  nameZh: "黏土拟态",
  nameEn: "Claymorphism",
  years: "约 2021 年—",
  origin: "设计社区",
  definition: "黏土拟态把界面元素吹胀成圆润的 3D 黏土——深外阴影 + 内阴影，色彩柔和饱满，是新拟态的\"友好继任者\"。",
  definitionEn: "Claymorphism inflates interface elements into soft, rounded 3D clay — deep outer shadows plus inner shadows, soft saturated colors — the friendly successor to neumorphism.",
  intro: [
    "黏土拟态属于扁平化之后的\"深度回归\"家族。2013 年扁平化终结了拟物化时代，2014 年谷歌的质感设计把深度带回规则，2019 年新拟态试图用\"从背景里挤出来\"的柔和立体接棒，却因对比度与可定制性的短板没能走远。2020 年玻璃拟态登场，2021 年黏土拟态接棒：3D 黏土质感的圆润立体元素，深外阴影 + 内阴影，色彩柔和饱满——新拟态的\"友好继任者\"。",
    "它的诀窍是\"吹胀\"：把新拟态的形状吹胀成圆顶状的立体，把元素从背景上\"浮\"起来，而不是从背景里\"挤\"出来。深外阴影负责托起，两个内阴影（一亮一暗）负责塑形，背景色从此不再受限——这是它相对新拟态最实在的一处进步（马莱维奇命名文章；Smashing Magazine 2022 年文章，均见来源）。",
    "区别一张表说清：质感设计是系统（规则最全，做产品用它）；玻璃拟态是材质（模糊 + 半透明，做氛围用它）；黏土拟态是造型（膨胀的圆润 3D，做亲和用它）。选风格先看需求，再看这张表。",
  ],
  promptZh: "用黏土拟态风格设计一个儿童教育 App 的首页：吹胀的圆润 3D 按钮、柔和饱满的色彩、深外阴影，友好、柔软、像玩具。",
  promptEn: "Design a kids' education app home screen in claymorphism style: inflated rounded 3D buttons, soft saturated colors, deep outer shadows — friendly, soft, toy-like.",
  variants: [
    {
      label: "产品",
      zh: "用黏土拟态风格做一个儿童绘本 App 的书架页：吹胀的圆润 3D 封面卡片、柔和饱满的粉彩、深外阴影 + 内高光，友好、柔软、像积木。",
      en: "Design a kids' picture-book app bookshelf in claymorphism style: inflated rounded 3D cover cards, soft saturated pastels, deep outer shadows with inner highlights — friendly, soft, toy-block-like.",
    },
    {
      label: "品牌",
      zh: "用黏土拟态风格设计一个玩具电商店铺首页：膨胀的圆润 3D 商品卡、黏土哑光质感、柔和饱满的色彩与深外阴影，温暖、好玩、想捏一下。",
      en: "Design a toy store home page in claymorphism style: inflated rounded 3D product cards, matte clay texture, soft saturated colors with deep outer shadows — warm, playful, squeezable.",
    },
    {
      label: "插画",
      zh: "用黏土拟态风格做一张 3D 插画海报：吹胀的黏土小人与圆润气球形状、哑光质感、深外阴影，温暖、友好、像定格动画。",
      en: "Make a 3D illustration poster in claymorphism style: inflated clay characters and rounded balloon shapes, matte finish, deep outer shadows — warm, friendly, stop-motion-like.",
    },
  ],
  palette: [
    { hex: "#F4B8C1", name: "黏土粉", role: "柔和饱满" },
    { hex: "#D6A2FF", name: "黏土紫", role: "浅紫" },
    { hex: "#F9AE01", name: "黏土黄", role: "明亮点缀" },
    { hex: "#B8E8D4", name: "黏土薄荷", role: "柔和粉彩" },
    { hex: "#A9D6F5", name: "黏土天蓝", role: "柔和粉彩" },
    { hex: "#2D3557", name: "黏土墨", role: "文字与深色" },
  ],
  typography: "细无衬线 Inter（OFL）或 Poppins（OFL）。",
  composition: ["圆润膨胀元素 + 深外阴影", "元素浮于背景之上", "层级靠阴影与色彩，不靠描边"],
  forms: "膨胀圆润的 3D 形；大圆角（通常 24–48px）、圆顶状按钮与卡片。",
  texture: "黏土哑光、深外阴影 + 内阴影；内阴影一亮（左上）一暗（右下），塑出黏土的体积感。",
  donts: ["黏土不用在严肃金融场景", "不要在同一页滥用——用在关键卡片与主按钮上，配扁平骨架", "黏土元素上的文字必须保证对比度（加深文字色或加阴影）"],
  gallery: [
    {
      title: "黏土拟态 Claymorphism",
      artist: "米哈乌·马莱维奇",
      year: "2021—",
      status: "版权期",
      note: "看：把新拟态的形状\"吹胀\"——圆润黏土 3D + 深外阴影；新拟态的友好继任者。",
      link: "https://hype4.academy/articles/design/claymorphism-in-user-interfaces",
      linkLabel: "查看原文（Hype4）↗",
    },
    {
      title: "《Claymorphism: Will It Stick Around?》",
