---
import Base from "../layouts/Base.astro";
import type { Lang } from "../lib/i18n";
import tokensJson from "../../tokens/tokens.json";

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === "en";
const T: any = tokensJson as any;
const colors = Object.entries(T.color as Record<string, any>)
  .filter(([, v]) => v && typeof v === "object" && "$value" in v)
  .map(([k, v]) => ({ name: `color.${k}`, value: String(v.$value), desc: v.$description || "" }));
const inkColors = Object.entries((T.color.ink || {}) as Record<string, any>).filter(([, v]) => v && typeof v === "object" && "$value" in v).map(([k, v]) => ({ name: `color.ink.${k}`, value: String(v.$value), desc: v.$description || "" }));
const sizes = Object.entries(T.font.size as Record<string, any>).filter(([, v]) => v && typeof v === "object" && "$value" in v).map(([k, v]) => ({ name: `font.size.${k}`, px: v.$value.value }));
const radii = Object.entries(T.radius as Record<string, any>).filter(([, v]) => v && typeof v === "object" && "$value" in v).map(([k, v]) => ({ name: `radius.${k}`, px: v.$value.value }));
const spacings = Object.entries(T.spacing as Record<string, any>).filter(([, v]) => v && typeof v === "object" && "$value" in v).map(([k, v]) => ({ name: `spacing.${k}`, px: v.$value.value }));
const durations = Object.entries(T.motion.duration as Record<string, any>).filter(([, v]) => v && typeof v === "object" && "$value" in v).map(([k, v]) => ({ name: `motion.duration.${k}`, ms: v.$value.value, desc: v.$description || "" }));
const easings = Object.entries(T.motion.easing as Record<string, any>).filter(([, v]) => v && typeof v === "object" && "$value" in v).map(([k, v]) => ({ name: `motion.easing.${k}`, css: `cubic-bezier(${(v.$value as number[]).join(", ")})`, desc: v.$description || "" }));
const swatch = (c: { name: string; value: string; desc: string }) => c;
---

<Base lang={lang} title={en ? "Design Tokens" : "设计令牌 TokenSet"} current="learn">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10">
    <h1 class="text-3xl font-bold tracking-tight">{en ? "Design Tokens" : "设计令牌"}</h1>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink2">
      {en
        ? "The single source of every color, size, and motion value on this site (W3C DTCG format). Prompts reference tokens as {{token:color/primary}} — the prompt pages resolve them to these values. Black / white / gray only, bright white as the base."
        : "本站一切颜色、尺寸、动效数值的唯一源头（W3C DTCG 格式）。提示词里以 {{token:color/primary}} 形式引用令牌，提示词页会自动替换成这里的值。只有黑白灰，亮白作底。"}
    </p>
    <p class="mt-3 text-sm text-muted">{en ? "Machine file: " : "机器文件："}<a class="hover:underline underline-offset-4" href="/registry.json">registry.json</a> 中的 <span class="font-mono">aglaia-tokens</span>（registry:theme）</p>

    <h2 class="mt-10 text-xl font-bold">{en ? "Colors" : "颜色"}</h2>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {[...colors, ...inkColors].map((c) => (
        <div class="overflow-hidden rounded-lg border border-line bg-surface">
          <div class="h-16 border-b border-line" style={`background:${c.value.startsWith("{") ? "#141414" : c.value}`}></div>
          <div class="p-3">
            <div class="font-mono text-xs font-semibold">{c.name}</div>
            <div class="font-mono text-xs text-muted">{c.value}</div>
            {c.desc && <div class="mt-1 text-xs text-ink2">{c.desc}</div>}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-2">
      <section>
        <h2 class="text-xl font-bold">{en ? "Type scale (base 16 × 1.25)" : "字阶（基准 16 × 1.25）"}</h2>
        <div class="mt-3 space-y-2">
          {sizes.map((s) => (
            <div class="flex items-baseline gap-3 border-b border-line pb-2">
              <span class="w-28 shrink-0 font-mono text-xs text-muted">{s.name}</span>
              <span style={`font-size:${Math.min(s.px, 40)}px`} class={s.px >= 20 ? "font-bold leading-tight" : "leading-tight"}>Aglaia 阿格莱亚</span>
              <span class="font-mono text-xs text-muted">{s.px}px</span>
            </div>
          ))}
        </div>
        <h2 class="mt-8 text-xl font-bold">{en ? "Radius" : "圆角"}</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          {radii.map((r) => (
            <div class="text-center">
              <div class="h-14 w-14 border-2 border-ink bg-subtle" style={`border-radius:${Math.min(r.px, 28)}px`}></div>
              <div class="mt-1 font-mono text-[11px] text-muted">{r.name}<br />{r.px}px</div>
            </div>
          ))}
        </div>
      </section>
      <section>
        <h2 class="text-xl font-bold">{en ? "Spacing (8pt)" : "间距（8pt）"}</h2>
        <div class="mt-3 space-y-1.5">
          {spacings.map((s) => (
            <div class="flex items-center gap-3">
              <span class="w-24 shrink-0 font-mono text-xs text-muted">{s.name}</span>
              <div class="h-3.5 bg-ink" style={`width:${s.px}px`}></div>
              <span class="font-mono text-xs text-muted">{s.px}px</span>
            </div>
          ))}
        </div>
        <h2 class="mt-8 text-xl font-bold">{en ? "Motion" : "动效"}</h2>
        <ul class="mt-3 space-y-1.5 text-sm">
          {durations.map((d) => <li class="flex gap-3"><span class="w-44 shrink-0 font-mono text-xs text-muted">{d.name}</span><span class="font-mono text-xs">{d.ms}ms</span><span class="text-ink2">{d.desc}</span></li>)}
        </ul>
        <ul class="mt-3 space-y-1.5 text-sm">
          {easings.map((e) => <li class="flex gap-3"><span class="w-44 shrink-0 font-mono text-xs text-muted">{e.name}</span><span class="font-mono text-xs">{e.css}</span><span class="text-ink2">{e.desc}</span></li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>
