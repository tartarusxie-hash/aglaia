---
import Base from "../layouts/Base.astro";
import { lp, type Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === "en";
---

<Base lang={lang} title={en ? "Contact" : "联系我们"} description={en ? "Aglaia is in preview; contact channels will be published at launch." : "阿格莱亚正在预览阶段，联系渠道将在正式上线时公布。"} current="contact">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-10">
    <div class="flex flex-col sm:flex-row gap-8 sm:items-center">
      <figure class="shrink-0">
        <img src="/brand/mascot-standing.jpg" alt={en ? "Aglaia, the site mascot" : "吉祥物阿格莱亚"} class="w-40 sm:w-48 rounded-2xl border border-line" width="750" height="880" />
      </figure>
      <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight">{en ? "Contact" : "联系我们"}</h1>
        <p class="mt-3 max-w-2xl leading-relaxed text-ink2">
          {en
            ? "Aglaia is still in preview, and we're a small open-source project. Contact channels will be published here when the site officially launches — until then, everything about the project lives on the About page."
            : "阿格莱亚还在预览阶段，我们是一个小小的开源项目。正式联系渠道将在网站正式上线时公布在这里——在那之前，项目的来历与现状都写在关于页。"}
        </p>
        <p class="mt-5">
          <a href={lp(lang, "/about")} class="rounded-md bg-primary px-5 py-3 font-semibold text-onprimary hover:opacity-90 transition-opacity inline-block">
            {en ? "About Aglaia →" : "了解阿格莱亚 →"}
          </a>
        </p>
      </div>
    </div>
  </div>
</Base>
