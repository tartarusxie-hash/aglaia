---
import Base from "../layouts/Base.astro";
import AvatarPicker from "../components/AvatarPicker.astro";
import { DEFAULT_AVATAR_ID } from "../lib/avatars.mjs";
import { dict, lp, type Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = dict(lang);
const a = d.account;
const en = lang === "en";
const settingsHref = lp(lang, "/account/settings");
// 表单字段统一样式（沿用搜索框的输入样式）
const inputCls = "w-full rounded-md border border-linestrong bg-surface px-3.5 py-2.5 text-[15px] placeholder:text-muted";
const labelCls = "mb-1.5 block text-sm font-medium";
const errCls = "mt-1 hidden text-sm text-red-600";
const btnCls = "w-full rounded-md bg-primary px-4 py-2.5 font-semibold text-onprimary transition-opacity hover:opacity-90 disabled:opacity-50";
const tabs = [
  { key: "posts", label: a.tabPosts, empty: a.emptyPosts },
  { key: "likes", label: a.tabLikes, empty: a.emptyLikes },
  { key: "favorites", label: a.tabFavorites, empty: a.emptyFavorites },
  { key: "following", label: a.tabFollowing, empty: a.emptyFollowing },
  { key: "followers", label: a.tabFollowers, empty: a.emptyFollowers },
] as const;
---

<Base lang={lang} title={en ? "Account" : "账号"} description={en ? "Log in or sign up for an Aglaia account." : "登录或注册阿格莱亚账号。"} current="account">
  <!-- 加载态：先请求 /api/auth/me 再决定显示登录/注册还是个人页 -->
  <div id="account-loading" class="mx-auto max-w-xl px-4 pt-24 pb-16 text-center sm:px-6">
    <p class="text-muted">{a.loading}</p>
  </div>
  <noscript>
    <div class="mx-auto max-w-xl px-4 pt-24 pb-16 text-center sm:px-6">
      <p class="text-muted">{en ? "Please enable JavaScript to use your account." : "请开启 JavaScript 后使用账号功能。"}</p>
    </div>
  </noscript>

  <!-- 未登录：登录 / 注册 -->
  <div id="account-auth" class="mx-auto hidden max-w-md px-4 pt-14 pb-16 sm:px-6 sm:pt-20">
    <div class="rounded-xl border border-line bg-surface p-6 sm:p-8">
      <div class="flex gap-6 border-b border-line" role="tablist">
        <button id="tab-login" type="button" role="tab" class="-mb-px border-b-2 border-ink px-1 pb-3 font-semibold">{a.loginTab}</button>
        <button id="tab-register" type="button" role="tab" class="-mb-px border-b-2 border-transparent px-1 pb-3 text-ink2">{a.signupTab}</button>
      </div>

      <div id="auth-alert" role="alert" class="mt-5 hidden rounded-md border border-red-200 bg-red-50 px-3.5 py-2.5 text-sm text-red-700"></div>

      <!-- 登录 -->
      <form id="form-login" class="mt-6 space-y-5" novalidate>
        <div>
          <label for="login-email" class={labelCls}>{a.email}</label>
          <input id="login-email" name="email" type="email" autocomplete="email" placeholder={a.emailPlaceholder} class={inputCls} />
          <p id="login-email-err" class={errCls}></p>
        </div>
        <div>
          <label for="login-password" class={labelCls}>{a.password}</label>
          <input id="login-password" name="password" type="password" autocomplete="current-password" class={inputCls} />
          <p id="login-password-err" class={errCls}></p>
        </div>
        <button id="login-submit" type="submit" class={btnCls}>{a.loginBtn}</button>
      </form>

      <!-- 注册：只收昵称、头像、邮箱、密码、密码确认 -->
      <form id="form-register" class="mt-6 hidden space-y-5" novalidate>
        <div>
          <label for="reg-nickname" class={labelCls}>{a.nickname}</label>
          <input id="reg-nickname" name="nickname" type="text" autocomplete="nickname" maxlength="20" placeholder={a.nicknamePlaceholder} class={inputCls} />
          <p id="reg-nickname-err" class={errCls}></p>
        </div>
        <div>
          <span class={labelCls}>{a.avatar}</span>
          <AvatarPicker lang={lang} prefix="reg" defaultPreset={DEFAULT_AVATAR_ID} />
          <p id="reg-avatar-err" class={errCls}></p>
        </div>
        <div>
          <label for="reg-email" class={labelCls}>{a.email}</label>
          <input id="reg-email" name="email" type="email" autocomplete="email" placeholder={a.emailPlaceholder} class={inputCls} />
          <p id="reg-email-err" class={errCls}></p>
        </div>
        <div>
          <label for="reg-password" class={labelCls}>{a.password}</label>
          <input id="reg-password" name="password" type="password" autocomplete="new-password" placeholder={a.passwordPlaceholder} class={inputCls} />
          <p id="reg-password-err" class={errCls}></p>
        </div>
        <div>
          <label for="reg-password-confirm" class={labelCls}>{a.passwordConfirm}</label>
          <input id="reg-password-confirm" name="password_confirm" type="password" autocomplete="new-password" placeholder={a.passwordConfirmPlaceholder} class={inputCls} />
          <p id="reg-password-confirm-err" class={errCls}></p>
        </div>
        <button id="register-submit" type="submit" class={btnCls}>{a.signupBtn}</button>
      </form>
    </div>
  </div>

  <!-- 已登录：个人页（微博 / 成熟论坛式的壳；社区未上线，五个 tab 全部是空状态，不放假数据） -->
  <div id="account-profile" class="mx-auto hidden max-w-2xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16">
    <div class="flex items-start gap-5">
      <img id="profile-avatar" src="" alt="" width="96" height="96" class="h-24 w-24 shrink-0 rounded-full object-cover" />
      <div class="min-w-0 flex-1">
        <h1 id="profile-nickname" class="truncate text-2xl font-bold tracking-tight"></h1>
        <p class="mt-1 text-sm text-muted"><span>{a.joined}</span> <span id="profile-joined"></span></p>
        <p id="profile-bio" class="mt-3 leading-relaxed text-ink2"></p>
      </div>
      <a href={settingsHref} class="shrink-0 rounded-md border border-linestrong px-3.5 py-1.5 text-sm font-medium hover:bg-subtle">{a.settings}</a>
    </div>

    <div class="mt-10 flex gap-1 overflow-x-auto border-b border-line" role="tablist">
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          data-profile-tab={t.key}
          aria-selected={i === 0 ? "true" : "false"}
          class={`-mb-px shrink-0 border-b-2 px-3 py-2.5 text-sm sm:px-4 ${i === 0 ? "border-ink font-semibold" : "border-transparent text-ink2"}`}
        >{t.label}</button>
      ))}
    </div>
    {tabs.map((t, i) => (
      <div data-profile-panel={t.key} class={i === 0 ? "py-16 text-center" : "hidden py-16 text-center"}>
        <p class="text-muted">{t.empty}</p>
        <p class="mt-2 text-sm text-muted">{a.communitySoon}</p>
      </div>
    ))}
  </div>

  <script>
    import { ApiError, getMe, login, register, uploadAvatar, formatDate, initialAvatar, notifyAuthChanged } from "../lib/account-client";
    import { initAvatarPicker } from "../lib/avatar-picker";
    import { dict } from "../lib/i18n";

    // 注意：不能用 define:vars 传文案——带 define:vars 的脚本会被 Astro 内联成经典脚本，无法使用 import。
    // 文案直接从 i18n 字典取，语言跟 <html lang>（与 SearchPage 同一做法）。
    const LANG = document.documentElement.lang === "en" ? "en" : "zh";
    const STR = dict(LANG).account;

    const $ = (id) => document.getElementById(id);
    const loadingEl = $("account-loading");
    const authEl = $("account-auth");
    const profileEl = $("account-profile");
    const alertEl = $("auth-alert");

    const tabLoginBtn = $("tab-login");
    const tabRegisterBtn = $("tab-register");
    const loginForm = $("form-login");
    const registerForm = $("form-register");

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function showAlert(msg) {
      alertEl.textContent = msg;
      alertEl.classList.remove("hidden");
    }
    function hideAlert() { alertEl.classList.add("hidden"); alertEl.textContent = ""; }

    function setErr(id, msg) {
      const el = $(id);
      if (!el) return;
      if (msg) { el.textContent = msg; el.classList.remove("hidden"); }
      else { el.textContent = ""; el.classList.add("hidden"); }
    }

    function switchTab(tab) {
      const isLogin = tab === "login";
      tabLoginBtn.classList.toggle("border-ink", isLogin);
      tabLoginBtn.classList.toggle("font-semibold", isLogin);
      tabLoginBtn.classList.toggle("border-transparent", !isLogin);
      tabLoginBtn.classList.toggle("text-ink2", !isLogin);
      tabRegisterBtn.classList.toggle("border-ink", !isLogin);
      tabRegisterBtn.classList.toggle("font-semibold", !isLogin);
      tabRegisterBtn.classList.toggle("border-transparent", isLogin);
      tabRegisterBtn.classList.toggle("text-ink2", isLogin);
      loginForm.classList.toggle("hidden", !isLogin);
      registerForm.classList.toggle("hidden", isLogin);
      hideAlert();
      try {
        const u = new URL(location.href);
        u.searchParams.set("tab", tab);
        history.replaceState(null, "", u);
      } catch {}
    }
    tabLoginBtn?.addEventListener("click", () => switchTab("login"));
    tabRegisterBtn?.addEventListener("click", () => switchTab("register"));

    const picker = initAvatarPicker(document.querySelector("[data-avatar-picker]"), {
      onError: (kind) => setErr("reg-avatar-err", kind === "size" ? STR.errAvatarSize : STR.errAvatarType),
    });

    function showAuth() {
      loadingEl.classList.add("hidden");
      profileEl.classList.add("hidden");
      authEl.classList.remove("hidden");
    }

    function showProfile(user) {
      const avatar = $("profile-avatar");
      avatar.src = user.avatar_url || initialAvatar(user.nickname);
      avatar.alt = user.nickname;
      avatar.onerror = () => { avatar.onerror = null; avatar.src = initialAvatar(user.nickname); };
      $("profile-nickname").textContent = user.nickname;
      $("profile-joined").textContent = formatDate(user.created_at, LANG);
      $("profile-bio").textContent = (user.bio || "").trim() || STR.noBio;
      loadingEl.classList.add("hidden");
      authEl.classList.add("hidden");
      profileEl.classList.remove("hidden");
      document.title = `${user.nickname} · Aglaia ${LANG === "en" ? "" : "阿格莱亚"}`.trim();
    }

    // 个人页 tab 切换
    const profileTabs = Array.from(document.querySelectorAll("[data-profile-tab]"));
    const profilePanels = Array.from(document.querySelectorAll("[data-profile-panel]"));
    for (const btn of profileTabs) {
      btn.addEventListener("click", () => {
        for (const b of profileTabs) {
          const on = b === btn;
          b.classList.toggle("border-ink", on);
          b.classList.toggle("font-semibold", on);
          b.classList.toggle("border-transparent", !on);
          b.classList.toggle("text-ink2", !on);
          b.setAttribute("aria-selected", String(on));
        }
        for (const p of profilePanels) p.classList.toggle("hidden", p.dataset.profilePanel !== btn.dataset.profileTab);
      });
    }

    function unavailableText(err) {
      // 401 是「未登录」；其它状态（404/500/502…）与网络错误都是「服务暂不可用」
      if (err instanceof ApiError && err.status === 401) return null;
      return STR.errServiceUnavailable;
    }

    // 初始状态：?tab=register 时默认打开注册 tab
    if (new URLSearchParams(location.search).get("tab") === "register") switchTab("register");

    let settled = false;
    const settleTimer = setTimeout(() => {
      if (!settled) { settled = true; showAuth(); showAlert(STR.errServiceUnavailable); }
    }, 10000);
    getMe()
      .then((user) => {
        if (settled) return;
        settled = true;
        clearTimeout(settleTimer);
        showProfile(user);
      })
      .catch((err) => {
        if (settled) return;
        settled = true;
        clearTimeout(settleTimer);
        showAuth();
        const msg = unavailableText(err);
        if (msg) showAlert(msg);
      });

    // 登录
    loginForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideAlert();
      const email = $("login-email").value.trim();
      const password = $("login-password").value;
      let ok = true;
      if (!email) { setErr("login-email-err", STR.errRequired); ok = false; }
      else if (!EMAIL_RE.test(email)) { setErr("login-email-err", STR.errEmail); ok = false; }
      else setErr("login-email-err", "");
      if (!password) { setErr("login-password-err", STR.errRequired); ok = false; }
      else setErr("login-password-err", "");
      if (!ok) return;
      const btn = $("login-submit");
      btn.disabled = true;
      btn.textContent = STR.loggingIn;
      try {
        const user = await login(email, password);
        notifyAuthChanged();
        showProfile(user);
      } catch (err) {
        if (err instanceof ApiError && err.status === 401) showAlert(STR.errInvalidCredentials);
        else showAlert(unavailableText(err) || STR.errGeneric);
      } finally {
        btn.disabled = false;
        btn.textContent = STR.loginBtn;
      }
    });

    // 注册
    registerForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideAlert();
      const nickname = $("reg-nickname").value.trim();
      const email = $("reg-email").value.trim();
      const password = $("reg-password").value;
      const confirm = $("reg-password-confirm").value;
      let ok = true;
      if (!nickname || nickname.length > 20) { setErr("reg-nickname-err", STR.errNickname); ok = false; }
      else setErr("reg-nickname-err", "");
      if (!email) { setErr("reg-email-err", STR.errRequired); ok = false; }
      else if (!EMAIL_RE.test(email)) { setErr("reg-email-err", STR.errEmail); ok = false; }
      else setErr("reg-email-err", "");
      if (password.length < 8) { setErr("reg-password-err", STR.errPasswordShort); ok = false; }
      else setErr("reg-password-err", "");
      if (confirm !== password) { setErr("reg-password-confirm-err", STR.errPasswordMismatch); ok = false; }
      else setErr("reg-password-confirm-err", "");
      setErr("reg-avatar-err", "");
      if (!ok) return;
      const btn = $("register-submit");
      btn.disabled = true;
      btn.textContent = STR.signingUp;
      try {
        const sel = picker.getSelection();
        const payload = { nickname, email, password, password_confirm: confirm };
        if (sel.presetId) payload.avatar_preset_id = sel.presetId;
        let user = await register(payload);
        // 自定义头像文件：注册接口只收预设 id，文件走头像上传接口补传
        if (sel.file) {
          try {
            user = await uploadAvatar(sel.file);
          } catch {
            showAlert(STR.errAvatarUpload);
          }
        }
        notifyAuthChanged();
        showProfile(user);
      } catch (err) {
        if (err instanceof ApiError && err.status === 409) {
          setErr("reg-email-err", STR.errEmailTaken);
          showAlert(STR.errEmailTaken);
        } else if (err instanceof ApiError && err.status === 400) {
          const msg = err.message || STR.errGeneric;
          if (err.field === "nickname") setErr("reg-nickname-err", msg);
          else if (err.field === "email") setErr("reg-email-err", msg);
          else if (err.field === "password" || err.field === "password_confirm") setErr("reg-password-err", msg);
          showAlert(msg);
        } else {
          showAlert(unavailableText(err) || STR.errGeneric);
        }
      } finally {
        btn.disabled = false;
        btn.textContent = STR.signupBtn;
      }
    });
  </script>
</Base>
