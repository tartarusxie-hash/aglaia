---
// Enargeon 文献库式行条目：序号 + 分类英文小字 + 标题 + 一行中文摘要 + 元数据行。
// 序号是全局编号，过滤后保持不变（文献库的做法）。
import { dict, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  no: string;
  catEn: string;
  title: string;
  summary: string;
  meta: string;
  href: string;
  external?: boolean;
  stale?: boolean;
  /** 过滤分类（传了就带上 data-lib-item / data-lib-cat，供壳的通用脚本过滤分页）。 */
  cat?: string;
}

const { lang, no, catEn, title, summary, meta, href, external = false, stale = false, cat } = Astro.props;
const d = dict(lang);
---

<li class="border-b border-line py-4 first:pt-0" {...(cat !== undefined ? { "data-lib-item": "", "data-lib-cat": cat } : {})}>
  <a href={href} {...(external ? { target: "_blank", rel: "noopener" } : {})} class="group flex gap-4 sm:gap-5">
    <span class="w-10 shrink-0 pt-0.5 font-mono text-sm text-muted">{no}</span>
    <span class="min-w-0 flex-1">
      <span class="text-[11px] font-medium uppercase tracking-wide text-muted">{catEn}</span>
      <span class="mt-0.5 block font-semibold leading-snug group-hover:underline underline-offset-4">
        {title}{external ? " ↗" : ""}
        {stale && <span class="ml-2 rounded border border-linestrong px-1.5 py-0.5 align-middle text-[11px] font-normal text-ink2 no-underline">{d.misc.stale}</span>}
      </span>
      <span class="mt-1 block text-sm leading-relaxed text-ink2">{summary}</span>
      {meta && <span class="mt-1 block text-xs text-muted">{meta}</span>}
    </span>
  </a>
</li>
