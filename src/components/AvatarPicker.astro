---
// 头像选择器：40 个预设圆形按钮 + 自定义上传格。
// 交互在 src/lib/avatar-picker.ts（initAvatarPicker）里接线；
// 选中态默认由 defaultPreset 决定（aria-pressed="true"）。
import { AVATARS } from "../lib/avatars.mjs";
import { dict, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  /** 唯一前缀，避免同一页多个选择器时 id 冲突 */
  prefix: string;
  /** 默认选中的预设 id */
  defaultPreset?: string | null;
}
const { lang, prefix, defaultPreset = null } = Astro.props;
const a = dict(lang).account;
const inputId = `${prefix}-avatar-upload`;
---

<div data-avatar-picker>
  <p class="text-sm font-medium text-ink2">{a.chooseAvatar}</p>
  <!-- 手机 5 列、桌面 8 列；40 个预设正好排满整行 -->
  <div class="mt-3 grid grid-cols-5 gap-2 sm:grid-cols-8 sm:gap-2.5" role="radiogroup" aria-label={a.avatar}>
    {AVATARS.map((av) => (
      <button
        type="button"
        data-avatar-id={av.id}
        aria-pressed={av.id === defaultPreset ? "true" : "false"}
        aria-label={lang === "en" ? av.labelEn : av.labelZh}
        title={lang === "en" ? av.labelEn : av.labelZh}
        class="aspect-square w-full overflow-hidden rounded-full"
      >
        <img src={av.src} alt="" width="64" height="64" loading="lazy" class="h-full w-full object-cover" />
      </button>
    ))}
    <!-- 自定义上传格：与预设同尺寸的圆形虚线格，选中文件后显示预览 -->
    <label
      for={inputId}
      data-avatar-upload-tile
      class="relative flex aspect-square w-full cursor-pointer items-center justify-center overflow-hidden rounded-full border-2 border-dashed border-linestrong bg-subtle"
      title={a.uploadAvatar}
    >
      <span data-avatar-upload-icon class="text-2xl leading-none text-muted" aria-hidden="true">+</span>
      <img data-avatar-upload-preview alt="" class="absolute inset-0 hidden h-full w-full object-cover" />
    </label>
  </div>
  <input id={inputId} data-avatar-upload type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
  <p class="mt-2 text-xs text-muted">{a.uploadHint}</p>
</div>
