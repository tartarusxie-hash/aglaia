---
// 通用分区轮播：StyleCarousel 机制的通用版（同一套三份拷贝 + transform 平移、
// 居中放大、拖拽、悬停暂停），多加一个 direction：
//   rtl（默认）——卡片向左走、新卡从右进，与艺术风格轮播完全一致；
//   ltr ——卡片向右走、新卡从左进，自动推进时索引反向移动，循环衔接逻辑对称。
// StyleCarousel 本身不动（首页第三页 + 艺术风格框继续用它），本组件只给
// 资源库枢纽页的新分区框用，避免改动已验证的轮播。
// 注意：一页上有多个本组件实例，脚本必须用 querySelectorAll 逐个初始化，
// 不能像 StyleCarousel 那样只 querySelector 第一个；N（条目数）从 data 属性读，
// 不能写死。居中量卡宽必须用 offsetWidth（见 StyleCarousel 旧坑注释）。
// 卡片分两种：visual（演示舞台 + 标题，组件/效果）与 text（标题 + 一行小字 + 元数据，
// 提示词/资源/学设计/skills）。演示 CSS 每条只输出一次（不在三份拷贝里重复）。
import { dict, type Lang } from "../lib/i18n";

export interface SectionCard {
  href: string;
  external?: boolean;
  title: string;
  sub?: string;
  meta?: string;
  demoHtml?: string;
  demoCss?: string;
  animated?: boolean;
  /** 演示是否按 158×98 设计舞台画的（组件是，效果不是——效果是流式布局，
      按约 200px+ 舞台设计）。为 true 时先按设计尺寸渲染再等比放大铺满舞台。 */
  demoScale?: boolean;
  /** 字体卡预览：用该字体本身渲染一行预览字（仅拉丁字体；中文字体不设此项）。 */
  preview?: { text: string; fontFamily: string };
}

interface Props {
  lang: Lang;
  label: string;
  direction?: "rtl" | "ltr";
  variant?: "visual" | "text";
  cards: SectionCard[];
}

const { lang, label, direction = "rtl", variant = "text", cards } = Astro.props;
const d = dict(lang);
const en = lang === "en";
const N = cards.length;
const copies = [0, 1, 2].flatMap((c) => cards.map((card) => ({ ...card, copy: c })));
const visual = variant === "visual";
---

<section
  data-sec
  data-sec-dir={direction}
  data-sec-n={N}
  class="sec-carousel relative"
  aria-label={label}
>
  {/* 演示 CSS 只输出一次（与三份拷贝无关，样式是全局的） */}
  {visual && cards.map((c) => c.demoCss && <style set:html={c.demoCss}></style>)}
  <div data-sec-viewport class="cursor-grab touch-pan-y overflow-hidden active:cursor-grabbing">
    <div
      data-sec-track
      class="flex gap-4 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform"
    >
      {copies.map((c, i) =>
        visual ? (
          <a
            href={c.href}
            {...(c.external ? { target: "_blank", rel: "noopener" } : {})}
            data-sec-item
            data-sec-pos={i % N}
            aria-label={c.title}
            class="fx-card group block w-[240px] shrink-0 scale-[0.8] rounded-xl border border-line bg-bg p-3 opacity-50 shadow-sm transition-all duration-500 sm:w-[264px]"
            data-fx-card
          >
            <span class="fx-stage relative block aspect-[16/10] overflow-hidden rounded-lg bg-subtle" data-fx-stage>
              {/*
                158×98 设计舞台的演示（组件）直接铺在 216/240px 宽的轮播舞台上会显得
                空荡（固定像素元素缩在角落、顶部锚定的布局下半留白），故先按设计尺寸
                渲染，再整体等比放大铺满舞台：手机端 216/158 ≈ 1.367，桌面端
                240/158 ≈ 1.519（卡片宽 240/264 减 p-3 两边各 12px）；高度
                98×1.367 ≈ 134 / 98×1.519 ≈ 149，与舞台高 135/150 只差约 1px。
                包装层 absolute 自身就是定位祖先，演示内部的绝对定位不受影响。
                效果演示是流式布局、按约 200px+ 舞台设计的，直接铺满即可，不放大
                （放大反而会把固定像素的按钮撑爆，见按钮按压感）。
              */}
              {c.demoScale ? (
                <span class="absolute left-0 top-0 block h-[98px] w-[158px] origin-top-left scale-[1.367] sm:scale-[1.519]">
                  <Fragment set:html={c.demoHtml || ""} />
                </span>
              ) : (
                <Fragment set:html={c.demoHtml || ""} />
              )}
              {c.animated && (
                <span class="pointer-events-none absolute bottom-2 right-2 rounded-full bg-ink/70 px-2 py-0.5 text-[11px] text-bg opacity-0 transition-opacity group-hover:opacity-100">{d.effect.hoverHint}</span>
              )}
            </span>
            <span class="mt-2.5 block truncate font-semibold leading-snug group-hover:underline underline-offset-4">{c.title}</span>
          </a>
        ) : (
          <a
            href={c.href}
            {...(c.external ? { target: "_blank", rel: "noopener" } : {})}
            data-sec-item
            data-sec-pos={i % N}
            aria-label={c.title}
            class="flex h-[156px] w-[240px] shrink-0 scale-[0.8] flex-col overflow-hidden rounded-xl border border-line bg-bg p-4 opacity-50 shadow-sm transition-all duration-500 sm:h-[172px] sm:w-[280px]"
          >
            <span class="line-clamp-2 font-semibold leading-snug">{c.title}{c.external ? " ↗" : ""}</span>
            {c.preview && (
              <span class="mt-1.5 truncate text-[22px] leading-snug" style={{ fontFamily: `'${c.preview.fontFamily}', sans-serif` }}>{c.preview.text}</span>
            )}
            {c.sub && <span class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink2">{c.sub}</span>}
            {c.meta && <span class="mt-auto truncate pt-2 text-xs text-muted">{c.meta}</span>}
          </a>
        ),
      )}
    </div>
  </div>

  <button
    type="button"
    data-sec-prev
    aria-label={en ? "Previous" : "上一个"}
    class="absolute -left-1 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-bg/90 text-lg shadow-sm backdrop-blur hover:bg-bg sm:flex"
  >
    ‹
  </button>
  <button
    type="button"
    data-sec-next
    aria-label={en ? "Next" : "下一个"}
    class="absolute -right-1 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-bg/90 text-lg shadow-sm backdrop-blur hover:bg-bg sm:flex"
  >
    ›
  </button>

  <style>
    .sec-carousel [data-sec-item].is-active {
      transform: scale(1);
      opacity: 1;
      box-shadow: 0 8px 24px rgba(20, 20, 20, 0.14);
    }
    @media (prefers-reduced-motion: reduce) {
      .sec-carousel [data-sec-track],
      .sec-carousel [data-sec-item] {
        transition: none !important;
      }
    }
  </style>

  <script>
    // 触屏点按演示卡：第一次只播放，再点才进详情（与 LibraryCard/EffectCard 同一套）。
    if (!(window as any).__fxTapBound) {
      (window as any).__fxTapBound = true;
      document.addEventListener("click", (ev) => {
        if (!window.matchMedia("(hover: none)").matches) return;
        const stage = (ev.target as HTMLElement).closest("[data-fx-stage]");
        if (!stage) return;
        const card = stage.closest("[data-fx-card]");
        if (card && !card.classList.contains("is-playing")) {
          ev.preventDefault();
          document.querySelectorAll(".fx-card.is-playing").forEach((c) => c.classList.remove("is-playing"));
          card.classList.add("is-playing");
        }
      });
    }

    // 一页多个实例，逐个初始化（Astro 会把本脚本只打包一次）。
    document.querySelectorAll("[data-sec]").forEach((root) => {
      const viewport = root.querySelector("[data-sec-viewport]");
      const track = root.querySelector("[data-sec-track]");
      const items = Array.from(root.querySelectorAll("[data-sec-item]"));
      const prevBtn = root.querySelector("[data-sec-prev]");
      const nextBtn = root.querySelector("[data-sec-next]");
      const N = Number((root as HTMLElement).dataset.secN || items.length / 3);
      // dir：自动推进的方向。rtl 与 StyleCarousel 一致（索引 +1，卡片向左走）；
      // ltr 反向（索引 -1，卡片向右走）。三份拷贝 + 归一化对两个方向对称成立。
      const dir = (root as HTMLElement).dataset.secDir === "ltr" ? -1 : 1;

      let index = N; // 从中间份的第一张开始
      let paused = false;
      let resumeTimer = 0;
      let autoTimer = 0;

      const metrics = () => {
        // 注意：卡片带 scale 缩放，getBoundingClientRect 量到的是缩放后的宽，
        // 会让平移量累计偏小、居中错位——必须用不受 transform 影响的 offsetWidth。
        const first = items[0] as HTMLElement | undefined;
        const w = first ? first.offsetWidth : 300;
        const gap = 16;
        const vw = viewport ? viewport.getBoundingClientRect().width : 0;
        return { w, gap, vw };
      };
      const translateFor = (i: number) => {
        const { w, gap, vw } = metrics();
        return vw / 2 - (i * (w + gap) + w / 2);
      };
      const setTransform = (x: number, animate: boolean) => {
        if (!track) return;
        (track as HTMLElement).style.transition = animate ? "" : "none";
        (track as HTMLElement).style.transform = `translateX(${x}px)`;
        if (!animate) void (track as HTMLElement).offsetWidth; // 强制重排，使下一次动画从新位置起算
      };
      const markActive = () => {
        items.forEach((el, i) => el.classList.toggle("is-active", i === index));
      };
      // 滑出中间份时跳回等价位置（内容相同，视觉无缝）。
      const normalize = () => {
        if (index >= 2 * N) { index -= N; setTransform(translateFor(index), false); }
        else if (index < N) { index += N; setTransform(translateFor(index), false); }
        markActive();
      };
      const goTo = (i: number, animate = true) => {
        index = i;
        setTransform(translateFor(index), animate);
        markActive();
      };
      const step = (d: number) => goTo(index + d);

      const startAuto = () => {
        stopAuto();
        if (paused) return;
        autoTimer = window.setInterval(() => {
          step(dir);
          window.setTimeout(normalize, 550);
        }, 2500);
      };
      const stopAuto = () => { if (autoTimer) { window.clearInterval(autoTimer); autoTimer = 0; } };
      const pause = () => { paused = true; stopAuto(); window.clearTimeout(resumeTimer); };
      const resumeSoon = () => {
        window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => { paused = false; startAuto(); }, 2500);
      };

      // 上/下一页按钮跟随自动方向（rtl 时 › = +1，与 StyleCarousel 一致；ltr 时 › = -1）。
      prevBtn?.addEventListener("click", () => { pause(); step(-dir); window.setTimeout(normalize, 550); resumeSoon(); });
      nextBtn?.addEventListener("click", () => { pause(); step(dir); window.setTimeout(normalize, 550); resumeSoon(); });

      root.addEventListener("mouseenter", pause);
      root.addEventListener("mouseleave", resumeSoon);
      root.addEventListener("focusin", pause);
      root.addEventListener("focusout", resumeSoon);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopAuto();
        else if (!paused) startAuto();
      });

      // 拖动：指针按下拖动轨道，松手吸附到最近一张；拖动则屏蔽点击。
      let dragging = false;
      let dragged = false;
      let startX = 0;
      let startT = 0;
      let curT = 0;
      const onDown = (e: PointerEvent) => {
        dragging = true;
        dragged = false;
        startX = e.clientX;
        startT = translateFor(index);
        curT = startT;
        pause();
        // 注意：不要在这里 setPointerCapture——捕获会把 mouseup 重定向到
        // viewport，click 的落点就变成 viewport 而不是卡片链接，鼠标点卡片
        // 永远进不了详情（2026-11-15 实测：真点击不跳转、JS click 可跳转）。
        // 捕获只在确认拖动后才接管（见 onMove），静止点按不经过捕获。
      };
      const onMove = (e: PointerEvent) => {
        if (!dragging) return;
        if (e.buttons === 0) { onUp(); return; } // 漏掉 pointerup 时的兜底
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 8) {
          if (!dragged) (viewport as HTMLElement | null)?.setPointerCapture?.(e.pointerId);
          dragged = true;
        }
        curT = startT + dx;
        setTransform(curT, false);
      };
      const onUp = () => {
        if (!dragging) return;
        dragging = false;
        const { w, gap, vw } = metrics();
        const raw = (vw / 2 - curT - w / 2) / (w + gap);
        const target = Math.max(0, Math.min(items.length - 1, Math.round(raw)));
        goTo(target);
        window.setTimeout(normalize, 550);
        resumeSoon();
      };
      viewport?.addEventListener("pointerdown", onDown);
      viewport?.addEventListener("pointermove", onMove);
      viewport?.addEventListener("pointerup", onUp);
      viewport?.addEventListener("pointercancel", onUp);
      // 未接管捕获时松手可能落在 viewport 外，window 上也兜底收尾
      //（onUp 有 dragging 守卫，重复触发无害）。
      window.addEventListener("pointerup", onUp);
      window.addEventListener("pointercancel", onUp);
      root.addEventListener("click", (e) => {
        if (dragged) { e.preventDefault(); e.stopPropagation(); dragged = false; }
      }, true);

      window.addEventListener("resize", () => setTransform(translateFor(index), false));

      goTo(N, false);
      startAuto();
    });
  </script>
</section>
